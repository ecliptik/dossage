diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index e53b31239..6035e2623 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -379,6 +379,12 @@ static volatile bool g_dos_audio_hard_park = false;
    a time anyway. */
 static SDL_AudioDevice * volatile g_dos_audio_device = NULL;
 
+/* DOS-PORT patch 0146: nonzero while SDL_DOSAudioPump() (the application's own
+   loop) is running Iterate. PlayDevice skips its silence throttle only then; see
+   the comment there. A counter, not a bool, so a nested pump cannot clear it
+   early; touched only under device->lock. */
+static int g_dos_in_app_pump = 0;
+
 /* DOSKUTSU patch (SDL/0088): ring-fill query export state. Bytes-per-frame
    of the open device's DMA format (SB16 S16 stereo = 4), cached at OpenDevice
    from SDL_AUDIO_FRAMESIZE(device->spec). Used by SDL_DOSAudioRingFill*() to
@@ -3437,6 +3443,10 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
 
     SDL_Log("SoundBlaster opened!");
 
+    /* DOS-PORT patch 0146: say which paths may sleep on a silent buffer. */
+    dos_port_dbg_log("audio: SDL/0146 silence throttle skipped inside SDL_DOSAudioPump() only; "
+                     "the device thread keeps its SDL_Delay(10)");
+
     /* DOSKUTSU patch (Phase 10 patch 0040): force-DSP-pause for fps-
        upper-bound measurement. When SDL_HINT_DOS_AUDIO_FORCE_DSP_PAUSE=1,
        request DSP pause immediately + suppress PlayDevice auto-resume.
@@ -3732,7 +3742,9 @@ bool SDL_DOSAudioPump(void)
        consistency with WaitDevice's own room check (line 720-721 of
        this file) -- same definition of "room" = same predicate
        boundary. */
+    g_dos_in_app_pump++;   /* DOS-PORT patch 0146: PlayDevice must not sleep the app's loop */
     bool iter_ok = SDL_PlaybackAudioThreadIterate(device);
+    g_dos_in_app_pump--;
     bool has_room = false;
 
     if (iter_ok) {
@@ -4254,7 +4266,28 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
                ISR increments consecutive-silent-IRQ counter -> DSP
                auto-engage idle-pause fires when threshold met -> IRQ-5
                stops -> fps recovered. Same mechanism as SDL/0050. */
-            SDL_Delay(10);  /* throttle ~100 iter/sec when quiescent;
+            /* DOS-PORT patch 0146: never sleep inside the application's pump.
+               The throttle below exists to stop the background playback
+               thread spinning through Iterate while there is nothing to
+               play. PlayDevice is also reached from the application's own
+               loop through SDL_DOSAudioPump() (SDL/0067), and there the
+               10 ms sleep lands on the game loop instead: e.g. a port
+               pumping once per game tick lost ~10 ms per silent tick. The
+               pump caller paces its own calls, so it needs no throttle
+               from here. The skip itself
+               is unchanged on both paths: the silent buffer is still not
+               written, so the SB still drains to its idle pause.
+               Decided structurally -- is this call inside SDL_DOSAudioPump()? --
+               not by a hint and not by thread identity: every other path,
+               the device thread included, keeps the throttle exactly as
+               before. (Thread identity was tried first and has a startup
+               window: device->thread is assigned only after SDL_CreateThread
+               returns, and on the cooperative scheduler the new thread runs
+               first; with SDL/0086's yield killswitched and silence at open
+               it would loop without sleeping or yielding and main would never
+               run again.) */
+            if (g_dos_in_app_pump == 0)
+                SDL_Delay(10);  /* throttle ~100 iter/sec when quiescent;
                                prevents CPU spin under cooperative
                                scheduler. Held under device->lock per
                                PlaybackAudioThreadIterate (SDL_audio.c:
