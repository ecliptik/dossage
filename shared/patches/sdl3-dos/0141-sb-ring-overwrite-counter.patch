 src/audio/dos/SDL_dosaudio_sb.c    | 9 +++++++++
 src/core/dos/SDL_dos_audio_synth.c | 8 ++++++++
 src/core/dos/SDL_dos_audio_synth.h | 4 ++++
 3 files changed, 21 insertions(+)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index f66645b5f..a2e06d64f 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -4033,6 +4033,15 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
     const int pos = hidden->ring_write & mask;
     const int first = (pos + buffer_size <= hidden->ring_size) ? buffer_size : (hidden->ring_size - pos);
 
+    /* DOS-PORT patch 0141: this write has no room check of its own (the
+       background thread's WaitDevice checks room before its Iterate, but
+       SDL_DOSAudioPump's Iterate does not), so count every write that lands
+       on bytes the ISR has not played yet. isr_ring_read only grows, so a
+       stale read here can only over-state the fill, never hide an overrun. */
+    if ((hidden->ring_write - isr_ring_read) + buffer_size > hidden->ring_size) {
+        dos_port_audio_ring_overwrite_count++;
+    }
+
     SDL_memcpy(hidden->ring_buffer + pos, buffer, first);
     if (first < buffer_size) {
         SDL_memcpy(hidden->ring_buffer, buffer + first, buffer_size - first);
diff --git a/src/core/dos/SDL_dos_audio_synth.c b/src/core/dos/SDL_dos_audio_synth.c
index 0a6893e9b..0ac709b93 100644
--- a/src/core/dos/SDL_dos_audio_synth.c
+++ b/src/core/dos/SDL_dos_audio_synth.c
@@ -1879,6 +1879,14 @@ volatile uint32_t dos_port_mpu_drr_cap = 10000;
    Per docs/internal/PIXTONE-MULTISOURCE-DESIGN.md sec.2.1 #2. */
 volatile uint32_t dos_port_audio_silent_irq_count = 0;
 
+/* DOS-PORT patch 0141: cumulative ring-overwrite counter. Incremented by
+   DOSSOUNDBLASTER_PlayDevice once per write whose chunk does not fit in the
+   ring's free space (write - read + chunk > ring_size): that write lands on
+   bytes the IRQ handler has not played yet. Written only from PlayDevice
+   (audio thread or the engine's SDL_DOSAudioPump call, both under
+   device->lock), read by the engine. Monotonic; never reset. */
+volatile uint32_t dos_port_audio_ring_overwrite_count = 0;
+
 /* DOSKUTSU patch (Phase 11 patch 0071): Lever 3 ISR-channel-pool
    active counter. Dual-writer (engine ++ in SDL_DOSSfxSynthStart, ISR
    -- at end-of-buffer). Atomicity required: both writers use
diff --git a/src/core/dos/SDL_dos_audio_synth.h b/src/core/dos/SDL_dos_audio_synth.h
index 577a62fc6..3e22911f9 100644
--- a/src/core/dos/SDL_dos_audio_synth.h
+++ b/src/core/dos/SDL_dos_audio_synth.h
@@ -408,6 +408,10 @@ extern volatile uint32_t dos_port_audio_sfx_active_count;
    probe contract. */
 extern volatile uint32_t dos_port_audio_silent_irq_count;
 
+/* DOS-PORT patch 0141: PlayDevice writes that overran unplayed ring data.
+   See SDL_dos_audio_synth.c. */
+extern volatile uint32_t dos_port_audio_ring_overwrite_count;
+
 /* DOSKUTSU patch (SDL/0096): cumulative WaveBlaster MIDI byte-dispatch
    counter. Incremented once per SDL_DOSMpu401WriteByte (every MIDI byte
    handed to the WB transport -- direct-port 0x330 or DSP-mediated). Single
