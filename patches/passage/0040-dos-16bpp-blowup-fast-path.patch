 gameSource/blowUp.cpp | 58 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/gameSource/blowUp.cpp b/gameSource/blowUp.cpp
index 7564e7e..9c93ead 100644
--- a/gameSource/blowUp.cpp
+++ b/gameSource/blowUp.cpp
@@ -133,6 +133,64 @@ void blowupOntoScreenNative( Uint32 *inImage, int inWidth, int inHeight,
         screenRowBufCapacity = neededBytes;
         }
 
+    // DOS-PORT: 16bpp fast path. The generic loop below calls
+    // SDL_MapSurfaceRGB() once per source pixel (1600 calls per frame) and
+    // issues inBlowFactor two-byte memcpy() calls per pixel (4800 per
+    // frame); measured on the 486DX2-50 + Mach64 rig (patch 0037's
+    // STAGEDBG.LOG) that costs 11.9 ms per frame, constant to 0.05 ms,
+    // for a 300x48 output -- far more than the pixel count justifies.
+    // This path does the same packing SDL_MapRGB does for a packed
+    // non-indexed, non-10-bit format -- (c >> (8 - bits)) << shift per
+    // channel, OR'd with Amask (SDL_pixels.c, SDL_MapRGB) -- with the
+    // shifts read once from the surface's SDL_PixelFormatDetails, and
+    // writes Uint16s directly. Output is identical by construction; the
+    // generic path stays for 24/32bpp.
+    if( bytesPerPixel == 2
+        && !SDL_ISPIXELFORMAT_INDEXED( inScreen->format )
+        && !SDL_ISPIXELFORMAT_10BIT( inScreen->format ) ) {
+
+        const int rLoss = 8 - destFormat->Rbits;
+        const int gLoss = 8 - destFormat->Gbits;
+        const int bLoss = 8 - destFormat->Bbits;
+        const int rShift = destFormat->Rshift;
+        const int gShift = destFormat->Gshift;
+        const int bShift = destFormat->Bshift;
+        const Uint16 aMask = (Uint16)destFormat->Amask;
+
+        Uint16 *rowBuf16 = (Uint16 *)screenRowBuf;
+
+        for( int y=0; y<inHeight; y++ ) {
+
+            const Uint32 *srcRow = inImage + y * inWidth;
+            Uint16 *dst = rowBuf16;
+
+            for( int x=0; x<inWidth; x++ ) {
+                const Uint32 pixelValue = srcRow[ x ];
+                const Uint32 r = ( pixelValue >> 16 ) & 0xFF;
+                const Uint32 g = ( pixelValue >> 8 ) & 0xFF;
+                const Uint32 b = pixelValue & 0xFF;
+                const Uint16 packed = (Uint16)(
+                    ( ( r >> rLoss ) << rShift ) |
+                    ( ( g >> gLoss ) << gShift ) |
+                    ( ( b >> bLoss ) << bShift ) |
+                    aMask );
+                for( int i=0; i<inBlowFactor; i++ ) {
+                    *dst++ = packed;
+                    }
+                }
+
+            int destRowStart =
+                ( yOffset + y * inBlowFactor ) * pitch + xOffset * 2;
+            Uint8 *destRow = pixels + destRowStart;
+            for( int i=0; i<inBlowFactor; i++ ) {
+                memcpy( destRow, screenRowBuf, newWidth * 2 );
+                destRow += pitch;
+                }
+            }
+
+        return;
+        }
+
     for( int y=0; y<inHeight; y++ ) {
 
         for( int x=0; x<inWidth; x++ ) {
