+/**
+ * DOS-PORT: like blowupOntoScreen, but packs each pixel into inScreen's
+ * OWN native pixel format and writes it there directly -- no intermediate
+ * fixed-format surface, no separate blit-conversion pass afterward.
+ *
+ * inImage is assumed packed as 0x00RRGGBB (matching gameImage's existing
+ * format elsewhere in this port). Only supports destination formats with
+ * 2, 3, or 4 bytes per pixel (i.e. not an indexed/paletted mode) -- caller
+ * must check this first (e.g. via SDL_GetPixelFormatDetails) and fall back
+ * to blowupOntoScreen + a blit for anything else. Caller is responsible
+ * for locking inScreen first if SDL_MUSTLOCK(inScreen) is true.
+ */
+void blowupOntoScreenNative( Uint32 *inImage, int inWidth, int inHeight,
+                             int inBlowFactor, SDL_Surface *inScreen );
