+// DOS-PORT: real-hardware measurement (486DX2-50) found the flip path
+// (this blowup + a separate SDL_BlitSurface format-conversion pass) the
+// single largest per-frame cost in this whole port's fps investigation --
+// the blit alone measured ~145-160ms/frame before its own rect-limiting
+// fix (patch 0013), and still ~25-37ms/frame afterward. The blit exists
+// because the game always renders into a fixed XRGB8888 renderSurface
+// first (patch 0003) -- necessary because raw Uint32 writes assuming
+// 32bpp XRGB corrupted real Mach64 hardware, which only offers banked
+// 24bpp, not 32bpp. But the actual problem there was writing an
+// UNVERIFIED format, not writing the real format -- this function packs
+// each pixel into whatever format the destination surface actually
+// negotiated (via SDL_MapSurfaceRGB, which reads the surface's own
+// SDL_PixelFormatDetails), eliminating the separate blit-conversion pass
+// entirely for any 2/3/4-bytes-per-pixel format. See flipGameImageOnto-
+// Screen() in game.cpp for the capability check and the (unmodified,
+// still real-hardware-verified) blowupOntoScreen()+blit fallback for any
+// format this doesn't support.
+void blowupOntoScreenNative( Uint32 *inImage, int inWidth, int inHeight,
+                             int inBlowFactor, SDL_Surface *inScreen ) {
+
+    const SDL_PixelFormatDetails *destFormat =
+        SDL_GetPixelFormatDetails( inScreen->format );
+    int bytesPerPixel = destFormat->bytes_per_pixel;
+
+    int newWidth = inBlowFactor * inWidth;
+    int newHeight = inBlowFactor * inHeight;
+
+    int yOffset = ( inScreen->h - newHeight ) / 2;
+    int xOffset = ( inScreen->w - newWidth ) / 2;
+
+    // pitch is already in bytes -- unlike blowupOntoScreen above, we
+    // don't convert it to a pixel count, since bytesPerPixel isn't
+    // necessarily 4 here.
+    int pitch = inScreen->pitch;
+
+    Uint8 *pixels = (Uint8 *)( inScreen->pixels );
+
+    // same reused-scratch-buffer pattern as blowupOntoScreen above, sized
+    // in bytes rather than Uint32s since bytesPerPixel varies.
+    static Uint8 *screenRowBuf = NULL;
+    static int screenRowBufCapacity = 0;
+    int neededBytes = newWidth * bytesPerPixel;
+    if( neededBytes > screenRowBufCapacity ) {
+        delete [] screenRowBuf;
+        screenRowBuf = new Uint8[ neededBytes ];
+        screenRowBufCapacity = neededBytes;
+        }
+
+    for( int y=0; y<inHeight; y++ ) {
+
+        for( int x=0; x<inWidth; x++ ) {
+
+            Uint32 pixelValue = inImage[ y * inWidth + x ];
+
+            Uint8 r = (Uint8)( ( pixelValue >> 16 ) & 0xFF );
+            Uint8 g = (Uint8)( ( pixelValue >> 8 ) & 0xFF );
+            Uint8 b = (Uint8)( pixelValue & 0xFF );
+
+            // packed is a Uint32 regardless of bytesPerPixel -- only its
+            // low bytesPerPixel bytes are meaningful, and on this
+            // x86/little-endian target those low bytes are exactly the
+            // ones a real N-bytes-per-pixel write would produce (SDL's
+            // own SDL_FillSurfaceRect3 uses the identical low-byte-first
+            // convention for 24bpp, confirmed by reading SDL_fillrect.c).
+            Uint32 packed = SDL_MapSurfaceRGB( inScreen, r, g, b );
+
+            int boxXStart = inBlowFactor * x;
+
+            Uint8 *rowDest = screenRowBuf + boxXStart * bytesPerPixel;
+            for( int i=0; i<inBlowFactor; i++ ) {
+                memcpy( rowDest, &packed, bytesPerPixel );
+                rowDest += bytesPerPixel;
+                }
+            }
+
+        int destRowStart =
+            ( yOffset + y * inBlowFactor ) * pitch + xOffset * bytesPerPixel;
+
+        Uint8 *destRow = pixels + destRowStart;
+        for( int i=0; i<inBlowFactor; i++ ) {
+            memcpy( destRow, screenRowBuf, newWidth * bytesPerPixel );
+            destRow += pitch;
+            }
+
+        }
+
     }
