diff --git a/gameSource/game.cpp b/gameSource/game.cpp
index 6aac800..144534f 100644
--- a/gameSource/game.cpp
+++ b/gameSource/game.cpp
@@ -101,16 +101,16 @@ double timeDelta = - ( (double)width / ( gameTime * lockedFrameRate ) );
 
 // DOS-PORT: the shared SDL3-DOS Sound Blaster backend
 // (SDL_dosaudio_sb.c) declares this as an "engine -> SDL extern" for its
-// Pixtone-active-channel diagnostic histogram -- a doskutsu/Cave-Story-
-// specific instrumentation feature baked into the shared patch series
-// (see sdl-dos-ports' shared/patches/sdl3-dos/README.md's "Known naming
-// debt" section) that every consumer must define at link time regardless
-// of whether it uses Pixtone. Passage has no Pixtone-equivalent SFX
-// system, so this stays permanently at 0 -- accurately reporting zero
-// active Pixtone channels, not a stub pretending to implement the
-// feature.
+// active-SFX-channel diagnostic histogram (generic across engines since
+// sdl-dos-ports commit 9e9c5a8 -- previously g_pixtone_active_count,
+// doskutsu/Cave-Story-specific naming debt; the shared patch series had
+// a regression that made this rename briefly unapplyable, fixed in
+// commit 6647fc8). Every consumer must define it at link time
+// regardless of whether it has an equivalent SFX-synth concept. Passage
+// doesn't, so this stays permanently at 0 -- accurately reporting zero
+// active channels, not a stub pretending to implement the feature.
 extern "C" {
-volatile uint32_t g_pixtone_active_count = 0;
+volatile uint32_t g_dos_sfx_synth_active_count = 0;
 }
 
 
@@ -376,11 +376,16 @@ int mainFunction( int inArgCount, char **inArgs ) {
 
 
     // read screen size from settings
+    // DOS-PORT: setting names are also the settings/*.ini basename
+    // (see minorGems' SettingsManager::getSettingsFileName) -- renamed
+    // to fit DOS 8.3 (screenWidth/screenHeight/fullscreen all exceed 8
+    // chars). See settings/ dir and World.cpp for the matching graphics
+    // filename renames done in the same pass.
     char widthFound = false;
-    int readWidth = SettingsManager::getIntSetting( "screenWidth", 
+    int readWidth = SettingsManager::getIntSetting( "width",
                                                     &widthFound );
     char heightFound = false;
-    int readHeight = SettingsManager::getIntSetting( "screenHeight", 
+    int readHeight = SettingsManager::getIntSetting( "height",
                                                     &heightFound );
     
     if( widthFound && heightFound ) {
@@ -400,7 +405,7 @@ int mainFunction( int inArgCount, char **inArgs ) {
 
 
     char fullscreenFound = false;
-    int readFullscreen = SettingsManager::getIntSetting( "fullscreen",
+    int readFullscreen = SettingsManager::getIntSetting( "fullscrn",
                                                          &fullscreenFound );
     if( fullscreenFound ) {
         fullScreen = readFullscreen;
