From 41bed213858089026d1073742de783cc7154156a Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Thu, 3 Sep 2026 12:37:18 -0700
Subject: [PATCH] dos: TEMPORARY per-stage frame-cost diagnostic (STAGEDBG.LOG)

REMOVAL IS PLANNED, NOT OPTIONAL. This patch exists to answer one
question and must be reverted once it has, landed separately from the
permanent 0036 so it can be removed without touching anything
load-bearing (the convention patches 0031/0032/0033 set).

WHY: docs/BENCHMARK-PLAN.md's Section 1 gate ("are we compute-bound?")
was measured on a 486DX2-66 -- 42.7ms of work against a 66.67ms budget,
~24ms of slack, pacer-bound -- and explicitly says to re-check it when
the CPU changes. The first 486DX2-50 datum (13.685fps, 73.1ms/frame,
zero frames shorter than one 55ms clock tick) says the regime changed:
the work now exceeds the budget on average. Which stage grew, and by how
much, is unmeasured on that CPU. The plan built on that datum (three
levers: audio conversion, blowup scaler, world sampler) needs the
per-stage numbers before any lever is pulled, not a model scaled from
66MHz.

WHAT: per 300-frame window, mean and max of each span on SDL's clock
(SDL_GetTicksNS, the same timebase as the pacer and 0036's capture):

  render  = loop top -> after drawScore()   (world sampling + score)
  blowup  = blowupOntoScreenNative()
  present = presentScreen()                  (VRAM flush)
  pump    = each SDL_DOSAudioPump() call in the engine pump loop, and
            the call count
  work    = loop top -> pacer entry          (all work before sleeping)
  pacer   = pacer entry -> post-pacer read   (the sleep; when the frame
            is over budget this is one SDL_Delay(0), i.e. one
            cooperative audio-thread iterate, so it exposes the audio
            conversion cost the frame-loop spans cannot see)
  tail    = post-pacer read -> loop end      (game logic, events)
  slack   = the pacer's remainingNS at entry (negative = over budget),
            mean and min, plus the over-budget frame count and the
            resync (debt clamp) count

and, from World.cpp, how many of the ~2400 sampleFromWorld() calls per
window took the cache-hit, cache-miss, or transient path -- the split
the render lever has to be chosen from.

One line per window to STAGEDBG.LOG (one fopen per ~20s of gameplay),
plus a partial-window line at the end of each life so nothing is lost.
Costs a normal frame about ten PIT reads and no file I/O -- the same
restraint 0031/0032 used, since per-frame logging was measured at
0.70ms/frame (SDL/0136) and ~0.4-0.5fps (patch 0028), enough to swamp
the effect being measured. The diagnostic's own emit lands inside one
frame's tail span per window; visible as a tail_max outlier, not hidden.

Detector verified to fire before use (DOSBox-X, correctness only): one
full natural life produced 14 full windows plus a 275-frame partial
(4475 frames), every field populated with plausible magnitudes, hit +
miss + transient summing to exactly 720000 per full window (2400 calls
x 300 frames) and 660000 for the partial, the startup transient visible
where expected (window 0: work_max 78ms, one resync, 253 pump calls)
and steady state showing zero engine pump calls because the cooperative
audio thread fills the ring inside the pacer's sleep -- the exact
mechanism this diagnostic is meant to expose once there is no sleep to
hide in. The same life's RUNMANIFEST read fps_p50=15.00 / fps_p95=14.81,
indistinguishable from the undiagnosed build's 15.00 / 14.83, so the
instrumentation cost is below what DOSBox-X can resolve. DOSBox-X's
numbers are otherwise not meaningful for the real question, per this
repo's rule.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017TKEXpxndNddTzMQkSdtBX
---
 gameSource/World.cpp |  15 ++++
 gameSource/game.cpp  | 181 ++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 194 insertions(+), 2 deletions(-)

diff --git a/gameSource/World.cpp b/gameSource/World.cpp
index a77dbea..9a313e2 100644
--- a/gameSource/World.cpp
+++ b/gameSource/World.cpp
@@ -371,6 +371,16 @@ char isSpritePresent( int inX, int inY ) {
 
 HashTable<rgbColor> worldSampleHashTable( 30000 );
 
+// DOS-PORT: TEMPORARY DIAGNOSTIC counters (see game.cpp's STAGEDBG.LOG
+// block) -- how many of the ~2400 sampleFromWorld() calls per frame take
+// the cache-hit path, the cache-miss path (full sampleFromWorldNoWeight
+// and insert), or the transient path (sprite/animation/chest pixels,
+// recomputed every frame by design). Read and reset per window by
+// game.cpp. Removal planned with that block.
+int dosPortDiagSampleHits = 0;
+int dosPortDiagSampleMisses = 0;
+int dosPortDiagSampleTransient = 0;
+
 
 void resetSampleHashTable() {
     worldSampleHashTable.clear();
@@ -404,6 +414,7 @@ rgbColor sampleFromWorldNoWeightHash( int inX, int inY ) {
 
 
     if( found ) {
+        dosPortDiagSampleHits ++;
         return sample;
         }
     
@@ -415,8 +426,12 @@ rgbColor sampleFromWorldNoWeightHash( int inX, int inY ) {
     
     // insert, but only if not transient
     if( !transient ) {
+        dosPortDiagSampleMisses ++;
         worldSampleHashTable.insert( inX, inY, sample );
         }
+    else {
+        dosPortDiagSampleTransient ++;
+        }
     
     return sample;
     }
diff --git a/gameSource/game.cpp b/gameSource/game.cpp
index ed59d03..8bb08f1 100644
--- a/gameSource/game.cpp
+++ b/gameSource/game.cpp
@@ -109,6 +109,115 @@ static int dosPortCompareFrameTimes( const void *inA, const void *inB ) {
         }
     return 0;
     }
+
+// DOS-PORT: TEMPORARY DIAGNOSTIC (STAGEDBG.LOG) -- per-stage frame cost,
+// aggregated per 300-frame window. REMOVAL IS PLANNED, NOT OPTIONAL: this
+// exists to re-run docs/BENCHMARK-PLAN.md's Section 1 compute-bound gate
+// on the 486DX2-50, where the first datum (13.685fps, 73.1ms/frame) says
+// the port is no longer pacer-bound, and to split the world-render loop
+// into cache-hit / cache-miss / transient sample counts so the render
+// lever can be picked from data. Same discipline as patches 0031/0032:
+// no per-frame file I/O (one fopen per 300 frames), a handful of
+// SDL_GetTicksNS() reads per frame (~10, each a PIT read), and every
+// span on the single SDL clock family.
+//
+// Spans, per frame:
+//   render  = loop top -> after drawScore()   (world sampling + score)
+//   blowup  = blowupOntoScreenNative()        (set inside flipGameImage..)
+//   present = presentScreen()                  (VRAM flush)
+//   pump    = every SDL_DOSAudioPump() call in the engine pump loop
+//   work    = loop top -> pacer entry          (everything before sleeping)
+//   pacer   = pacer entry -> post-pacer read   (sleep, or one yield if behind)
+//   tail    = post-pacer read -> loop end      (game logic, events)
+//   slack   = pacer's remainingNS at entry     (negative = over budget)
+struct DosPortDiagWindow {
+    int frames;
+    Uint64 renderNS, renderMaxNS;
+    Uint64 blowupNS, blowupMaxNS;
+    Uint64 presentNS, presentMaxNS;
+    Uint64 pumpNS, pumpMaxNS;
+    int pumpCalls;
+    Uint64 workNS, workMaxNS;
+    Uint64 pacerNS, pacerMaxNS;
+    Uint64 tailNS, tailMaxNS;
+    Sint64 slackSumNS, slackMinNS;
+    int overBudget, resyncs;
+    int hits, misses, transient;
+    };
+
+static struct DosPortDiagWindow dosPortDiag;
+static int dosPortDiagWindowIndex = 0;
+static Uint64 dosPortDiagBlowupNS = 0;
+static Uint64 dosPortDiagPresentNS = 0;
+
+// World.cpp's sample-cache counters (see sampleFromWorldNoWeightHash).
+extern int dosPortDiagSampleHits;
+extern int dosPortDiagSampleMisses;
+extern int dosPortDiagSampleTransient;
+
+#define DOS_PORT_DIAG_WINDOW_FRAMES 300
+
+static void dosPortDiagReset() {
+    memset( &dosPortDiag, 0, sizeof( dosPortDiag ) );
+    dosPortDiag.slackMinNS = (Sint64)0x7FFFFFFFFFFFFFFFLL;
+    dosPortDiagSampleHits = 0;
+    dosPortDiagSampleMisses = 0;
+    dosPortDiagSampleTransient = 0;
+    }
+
+static void dosPortDiagAccum( Uint64 *inSum, Uint64 *inMax, Uint64 inNS ) {
+    *inSum += inNS;
+    if( inNS > *inMax ) {
+        *inMax = inNS;
+        }
+    }
+
+static bool dosPortDiagPump() {
+    const Uint64 t0 = SDL_GetTicksNS();
+    const bool result = SDL_DOSAudioPump();
+    const Uint64 dt = SDL_GetTicksNS() - t0;
+    dosPortDiagAccum( &dosPortDiag.pumpNS, &dosPortDiag.pumpMaxNS, dt );
+    dosPortDiag.pumpCalls ++;
+    return result;
+    }
+
+static void dosPortDiagEmit( const char *inTag ) {
+    const int n = dosPortDiag.frames;
+    if( n <= 0 ) {
+        return;
+        }
+    FILE *f = fopen( "STAGEDBG.LOG", "a" );
+    if( f == NULL ) {
+        return;
+        }
+    const double ms = 1.0 / 1000000.0;
+    fprintf( f,
+             "[stage-window w=%d %s frames=%d] "
+             "render_avg=%.2f render_max=%.2f "
+             "blowup_avg=%.2f blowup_max=%.2f "
+             "present_avg=%.2f present_max=%.2f "
+             "pump_avg=%.2f pump_max=%.2f pump_calls=%d "
+             "work_avg=%.2f work_max=%.2f "
+             "pacer_avg=%.2f pacer_max=%.2f "
+             "tail_avg=%.2f tail_max=%.2f "
+             "slack_avg=%.2f slack_min=%.2f over_budget=%d resyncs=%d "
+             "hits=%d misses=%d transient=%d\n",
+             dosPortDiagWindowIndex, inTag, n,
+             dosPortDiag.renderNS * ms / n, dosPortDiag.renderMaxNS * ms,
+             dosPortDiag.blowupNS * ms / n, dosPortDiag.blowupMaxNS * ms,
+             dosPortDiag.presentNS * ms / n, dosPortDiag.presentMaxNS * ms,
+             dosPortDiag.pumpNS * ms / n, dosPortDiag.pumpMaxNS * ms,
+             dosPortDiag.pumpCalls,
+             dosPortDiag.workNS * ms / n, dosPortDiag.workMaxNS * ms,
+             dosPortDiag.pacerNS * ms / n, dosPortDiag.pacerMaxNS * ms,
+             dosPortDiag.tailNS * ms / n, dosPortDiag.tailMaxNS * ms,
+             (double)dosPortDiag.slackSumNS * ms / n,
+             (double)dosPortDiag.slackMinNS * ms,
+             dosPortDiag.overBudget, dosPortDiag.resyncs,
+             dosPortDiag.hits, dosPortDiag.misses, dosPortDiag.transient );
+    fclose( f );
+    dosPortDiagWindowIndex ++;
+    }
 #endif
 
 
@@ -508,9 +617,11 @@ void flipGameImageOntoScreen( SDL_Surface *inScreen ) {
             SDL_FillSurfaceRect( inScreen, NULL, 0 );
             }
 
+        const Uint64 dosDiagBlowupStartNS = SDL_GetTicksNS();
         blowupOntoScreenNative( gameImage,
                                 width, totalImageHeight, blowUpFactor,
                                 inScreen );
+        dosPortDiagBlowupNS = SDL_GetTicksNS() - dosDiagBlowupStartNS;
 
         if( screenLocked ) {
             SDL_UnlockSurface( inScreen );
@@ -522,7 +633,9 @@ void flipGameImageOntoScreen( SDL_Surface *inScreen ) {
         presentRect.x = ( inScreen->w - presentRect.w ) / 2;
         presentRect.y = ( inScreen->h - presentRect.h ) / 2;
 
+        const Uint64 dosDiagPresentStartNS = SDL_GetTicksNS();
         presentScreen( inScreen, &presentRect, blowUpChanged );
+        dosPortDiagPresentNS = SDL_GetTicksNS() - dosDiagPresentStartNS;
 
         // we've handled any blow up change
         blowUpChanged = false;
@@ -1142,6 +1255,18 @@ char playGame() {
     int frameCount = 0;
     unsigned long startTime = time( NULL );
 
+#ifdef __DJGPP__
+    dosPortDiagReset();
+    {
+        FILE *f = fopen( "STAGEDBG.LOG", "a" );
+        if( f != NULL ) {
+            fprintf( f, "[stage-window life-start window_frames=%d]\n",
+                     DOS_PORT_DIAG_WINDOW_FRAMES );
+            fclose( f );
+            }
+        }
+#endif
+
 #ifdef __DJGPP__
     // DOS-PORT: scoped identically to frameCount/startTime just above --
     // mainFunction()'s while(playGame()) loop can call this function many
@@ -1239,6 +1364,12 @@ char playGame() {
 
     while( !done ) {
 
+#ifdef __DJGPP__
+        const Uint64 dosDiagLoopTopNS = SDL_GetTicksNS();
+        Uint64 dosDiagPacerEntryNS = dosDiagLoopTopNS;
+        dosPortDiagBlowupNS = 0;
+        dosPortDiagPresentNS = 0;
+#endif
 
         if( getKeyDown( SDL_SCANCODE_S ) ) {
             stepDX = false;
@@ -1426,6 +1557,11 @@ char playGame() {
             }
 
         drawScore( gameImage, width, height, score );
+
+#ifdef __DJGPP__
+        dosPortDiagAccum( &dosPortDiag.renderNS, &dosPortDiag.renderMaxNS,
+                          SDL_GetTicksNS() - dosDiagLoopTopNS );
+#endif
         
 
         if( isPlayerDead() ) {
@@ -1610,7 +1746,7 @@ char playGame() {
                         }
                     }
 
-                if( !SDL_DOSAudioPump() ) {
+                if( !dosPortDiagPump() ) {
                     break;
                     }
                 pumpIters ++;
@@ -1618,7 +1754,7 @@ char playGame() {
 #else
             while( pumpIters < pumpMaxIters &&
                    SDL_DOSAudioRingFillMs() < pumpClampedTargetMs &&
-                   SDL_DOSAudioPump() ) {
+                   dosPortDiagPump() ) {
                 pumpIters ++;
                 }
 #endif
@@ -1717,6 +1853,22 @@ char playGame() {
             // measurement and resync rather than trust it.
             const Sint64 remainingNS = (Sint64)dosNextFrameDeadlineNS - (Sint64)nowNS;
 
+            dosDiagPacerEntryNS = nowNS;
+            dosPortDiagAccum( &dosPortDiag.workNS, &dosPortDiag.workMaxNS,
+                              nowNS - dosDiagLoopTopNS );
+            dosPortDiagAccum( &dosPortDiag.blowupNS, &dosPortDiag.blowupMaxNS,
+                              dosPortDiagBlowupNS );
+            dosPortDiagAccum( &dosPortDiag.presentNS,
+                              &dosPortDiag.presentMaxNS,
+                              dosPortDiagPresentNS );
+            dosPortDiag.slackSumNS += remainingNS;
+            if( remainingNS < dosPortDiag.slackMinNS ) {
+                dosPortDiag.slackMinNS = remainingNS;
+                }
+            if( remainingNS < 0 ) {
+                dosPortDiag.overBudget ++;
+                }
+
             if( remainingNS > (Sint64)dosFrameTickNS ) {
                 // Ahead by more than a whole frame: the clock lied (or the
                 // deadline is stale). Resync; never sleep on a bad reading.
@@ -1848,6 +2000,7 @@ char playGame() {
                 // visible speed-up rather than dropped frames. The known
                 // ~57ms first-flush stall lands here exactly once per run.
                 dosNextFrameDeadlineNS = nowNS + dosFrameTickNS;
+                dosPortDiag.resyncs ++;
                 SDL_Delay( 0 );
                 }
             else {
@@ -1887,6 +2040,9 @@ char playGame() {
         // a reject bucket, never in the buffer as a 2^64-scale "period".
         const Uint64 pacedNowNS = SDL_GetTicksNS();
 
+        dosPortDiagAccum( &dosPortDiag.pacerNS, &dosPortDiag.pacerMaxNS,
+                          pacedNowNS - dosDiagPacerEntryNS );
+
         if( dosLastPacedTicksNS != 0 ) {
             const Sint64 pacedPeriodNS =
                 (Sint64)pacedNowNS - (Sint64)dosLastPacedTicksNS;
@@ -2252,9 +2408,30 @@ char playGame() {
             maxExploreScore = exploreScore;
             }
 
+#ifdef __DJGPP__
+        dosPortDiagAccum( &dosPortDiag.tailNS, &dosPortDiag.tailMaxNS,
+                          SDL_GetTicksNS() - pacedNowNS );
+        dosPortDiag.frames ++;
+        if( dosPortDiag.frames >= DOS_PORT_DIAG_WINDOW_FRAMES ) {
+            dosPortDiag.hits = dosPortDiagSampleHits;
+            dosPortDiag.misses = dosPortDiagSampleMisses;
+            dosPortDiag.transient = dosPortDiagSampleTransient;
+            dosPortDiagEmit( "full" );
+            dosPortDiagReset();
+            }
+#endif
 
         }
 
+#ifdef __DJGPP__
+    // partial last window, so the end of a life is not lost
+    dosPortDiag.hits = dosPortDiagSampleHits;
+    dosPortDiag.misses = dosPortDiagSampleMisses;
+    dosPortDiag.transient = dosPortDiagSampleTransient;
+    dosPortDiagEmit( "partial" );
+    dosPortDiagReset();
+#endif
+
     unsigned long netTime = time( NULL ) - startTime;
     double frameRate = frameCount / (double)netTime;
     
