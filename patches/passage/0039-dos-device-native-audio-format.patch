-       file and the render tool read the same DOSSAGE_AUDIO_CHANNELS
-       define from the same Makefile variable, rather than each
-       hardcoding a channel count that could drift out of sync. */
-    audioFormat.freq = sampleRate;
-    audioFormat.format = SDL_AUDIO_S16;
-    audioFormat.channels = DOSSAGE_AUDIO_CHANNELS;
+    // DOS-PORT: open the stream in the WAV's OWN format, as SDL_LoadWAV
+    // reported it, not in the compile-time tier constants. Patches
+    // 0022-0026 passed DOSSAGE_SAMPLE_RATE/DOSSAGE_AUDIO_CHANNELS here and
+    // ignored songSpec; with the committed SONG.WAV being the low-tier
+    // render, a default high-tier build shipped a 11025Hz mono file under
+    // a 22050Hz stereo stream and the music played at 4x speed, two
+    // octaves up -- on every f1f867ccadad benchmark run, undetected for a
+    // day, because the file loads fine and AUDIO_PRESENT checks pass. The
+    // Makefile's stage-time tier guard catches a mismatch at build time;
+    // this makes the runtime correct regardless. The tier constants still
+    // drive tools/render-music (what gets rendered), and the device-rate
+    // request below now follows the file too.
+    //
+    // Then, once the device is open, convert the song ONCE into whatever
+    // format the device actually negotiated and tell the stream its input
+    // is now that format, so SDL's per-chunk conversion collapses to a
+    // memcpy. On this port's reference hardware (PicoGUS in Sound Blaster
+    // 2.0 mode: U8 mono, 8-bit DMA) that removes the 16-bit-to-float,
+    // stereo-to-mono, float-to-8-bit passes SDL otherwise runs on every
+    // 512-frame chunk -- 43% of every frame on a 486DX2-50 (patch 0038's
+    // message has the measurement). A real SB16 negotiates S16 stereo and
+    // the high-tier song already matches it: same fast path, no
+    // conversion needed.
+    songFormat = songSpec;
 
 #ifdef __DJGPP__
-    // DOS-PORT: request the PHYSICAL device open at sampleRate too, not
-    // just the logical stream -- without this, SDL3's own core floors
-    // the real device to 44100Hz regardless of what audioFormat.freq
-    // above asks for, forcing a resample on every pumped chunk. Must be
-    // called before SDL_OpenAudioDeviceStream (cached, consumed once at
-    // OpenDevice).
-    SDL_DOSAudioSetDeviceFrameRate( sampleRate );
+    // DOS-PORT: request the PHYSICAL device open at the song's rate too,
+    // not just the logical stream -- without this, SDL3's own core floors
+    // the real device to 44100Hz regardless of what the stream asks for,
+    // forcing a resample on every pumped chunk. Must be called before
+    // SDL_OpenAudioDeviceStream (cached, consumed once at OpenDevice).
+    SDL_DOSAudioSetDeviceFrameRate( songSpec.freq );
 #endif
 
     /* DOS-PORT: SDL3 opens a device+callback pair via
@@ -749,7 +898,7 @@ void startMusic( const char *inTGAFileName ) {
        fields moved out of SDL_AudioSpec and into this call's own
        arguments). */
     audioStream = SDL_OpenAudioDeviceStream( SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK,
-                                              &audioFormat,
+                                              &songSpec,
                                               audioCallback, NULL );
 
     if( audioStream == NULL ) {
@@ -757,6 +906,43 @@ void startMusic( const char *inTGAFileName ) {
         return;
         }
 
+    SDL_AudioSpec deviceSpec;
+    int deviceSampleFrames = 0;
+    char deviceNative = false;
+    if( SDL_GetAudioDeviceFormat( SDL_GetAudioStreamDevice( audioStream ),
+                                  &deviceSpec, &deviceSampleFrames ) ) {
+        if( convertSongToDeviceFormat( &songSpec, &deviceSpec ) ) {
