+            ( deviceSpec.format == SDL_AUDIO_U8 ) ? "U8" :
+            ( deviceSpec.format == SDL_AUDIO_S16 ) ? "S16" : "other",
+            (int)deviceSpec.channels, (int)deviceSpec.freq,
+            deviceSampleFrames,
+            deviceNative ? "converted once to device format"
