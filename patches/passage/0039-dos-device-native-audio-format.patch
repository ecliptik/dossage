--- a/gameSource/musicPlayer.cpp
+++ b/gameSource/musicPlayer.cpp
@@ -145,6 +145,15 @@ Uint8 *songBuffer = NULL;
 Uint32 songBufferLen = 0;
 Uint32 songReadPos = 0;
 
+// DOS-PORT: the format songBuffer is actually in, which is also the
+// stream's input format (see startMusic). After a successful device-
+// native conversion this is the device's own spec; otherwise it is the
+// WAV's spec as SDL_LoadWAV reported it. audioCallback reads its frame
+// and sample sizes from here, never from the compile-time tier constants.
+SDL_AudioSpec songFormat;
+int songFrameBytes = 4;
+int songBytesPerSample = 2;
+
 
 // need to synch these with audio thread
 
@@ -365,12 +374,25 @@ void synthesizeAudioCallback( void *inUserData, SDL_AudioStream *inStream,
 
 
 
-// DOS-PORT: the live playback callback. Copies (with wraparound at the
-// end of the pre-rendered song) from songBuffer, scaling each S16 sample
-// by musicLoudness -- the only per-callback cost is one multiply per
-// sample, versus synthesizeAudioCallback's per-note envelope*wavetable
-// math above. This is what startMusic() registers with
-// SDL_OpenAudioDeviceStream.
+// DOS-PORT: the live playback callback. Hands SDL the song's own bytes
+// (with wraparound at the end of the pre-rendered song), in the format
+// startMusic() converted the song to -- the device's native format
+// whenever that conversion was possible -- so that at unity gain the
+// whole per-chunk cost on both sides of the stream is a memcpy.
+//
+// The previous version scaled every sample through a double multiply,
+// two double compares and a float-to-int truncation, and heap-allocated
+// a buffer per call, and then SDL converted the result to the device
+// format per chunk (16-bit to float, stereo to mono, float to 8-bit on
+// the PicoGUS's 8-bit mono path). Measured on the 486DX2-50 + Mach64
+// rig (patch 0037's STAGEDBG.LOG, one natural life): that pipeline
+// cost 43% of every frame -- 3.23 engine pump calls at 10.0 ms each
+// plus one 10.3 ms cooperative audio-thread iterate per frame, 4.2
+// chunks of 23 ms audio produced per 98.8 ms frame -- against 54 ms of
+// actual game work. musicLoudness is exactly 1.0 for the whole of a
+// life except the title screen and the death fade, so the scaled path
+// below runs for a few seconds per life; it uses integer gain in the
+// song's own format through one reused scratch buffer.
 void audioCallback( void *inUserData, SDL_AudioStream *inStream,
                     int inAdditionalAmount, int inTotalAmount ) {
 
@@ -378,48 +400,173 @@ void audioCallback( void *inUserData, SDL_AudioStream *inStream,
         return;
         }
 
-    // round up to a whole number of S16 frames at this build's tier
-    // (DOSSAGE_AUDIO_CHANNELS * 2 bytes/frame -- 2 for mono, 4 for
-    // stereo). Everything else below (songReadPos, numSongSamples,
-    // wraparound) is already sample-count-based, not frame-pair-based,
-    // so it needs no further tier-awareness.
-    const int bytesPerFrame = DOSSAGE_AUDIO_CHANNELS * 2;
-    int numBytes =
-        ( ( inAdditionalAmount + bytesPerFrame - 1 ) / bytesPerFrame )
-        * bytesPerFrame;
+    // round up to a whole number of frames in the song's own format;
+    // songBufferLen is a whole number of frames too (a WAV data chunk,
+    // or a conversion of one), so the loop seam is always frame-aligned.
+    const int frameBytes = songFrameBytes;
+    Uint32 numBytes =
+        (Uint32)( ( ( inAdditionalAmount + frameBytes - 1 ) / frameBytes )
+                  * frameBytes );
+    if( numBytes == 0 ) {
+        return;
+        }
 
-    Uint8 *outputBuffer = new Uint8[ numBytes ];
+    Uint32 pos = songReadPos;
 
-    const Sint16 *songSamples = (const Sint16 *)songBuffer;
-    Sint16 *outSamples = (Sint16 *)outputBuffer;
-    int numSongSamples = songBufferLen / 2;
-    int readSampleIndex = songReadPos / 2;
-    int numOutSamples = numBytes / 2;
+    if( musicLoudness >= 1.0 ) {
+        // unity gain: no per-sample work at all, at most two puts when
+        // the request straddles the end of the song
+        while( numBytes > 0 ) {
+            Uint32 chunk = songBufferLen - pos;
+            if( chunk > numBytes ) {
+                chunk = numBytes;
+                }
+            SDL_PutAudioStreamData( inStream, songBuffer + pos, (int)chunk );
+            pos += chunk;
+            if( pos >= songBufferLen ) {
+                pos = 0;
+                }
+            numBytes -= chunk;
+            }
+        songReadPos = pos;
+        return;
+        }
+
+    // scaled (title screen, death fade): integer gain, scaled by 256
+    static Uint8 *scratch = NULL;
+    static Uint32 scratchCapacity = 0;
+    if( numBytes > scratchCapacity ) {
+        delete [] scratch;
+        scratch = new Uint8[ numBytes ];
+        scratchCapacity = numBytes;
+        }
 
-    for( int i=0; i<numOutSamples; i++ ) {
-        double scaled = songSamples[ readSampleIndex ] * musicLoudness;
+    int gain256 = (int)( musicLoudness * 256.0 );
+    if( gain256 < 0 ) {
+        gain256 = 0;
+        }
+    else if( gain256 > 256 ) {
+        gain256 = 256;
+        }
 
-        if( scaled > 32767 ) {
-            scaled = 32767;
+    if( songBytesPerSample == 1 ) {
+        // unsigned 8-bit, silence at 128
+        for( Uint32 i=0; i<numBytes; i++ ) {
+            int sample = (int)songBuffer[ pos ] - 128;
+            scratch[ i ] = (Uint8)( ( ( sample * gain256 ) >> 8 ) + 128 );
+            pos ++;
+            if( pos >= songBufferLen ) {
+                pos = 0;
+                }
             }
-        else if( scaled < -32768 ) {
-            scaled = -32768;
+        }
+    else {
+        // signed 16-bit
+        const Sint16 *src = (const Sint16 *)songBuffer;
+        Sint16 *dst = (Sint16 *)scratch;
+        const Uint32 numSongSamples = songBufferLen / 2;
+        const Uint32 numOutSamples = numBytes / 2;
+        Uint32 idx = pos / 2;
+        for( Uint32 i=0; i<numOutSamples; i++ ) {
+            dst[ i ] = (Sint16)( ( (int)src[ idx ] * gain256 ) >> 8 );
+            idx ++;
+            if( idx >= numSongSamples ) {
+                idx = 0;
+                }
             }
+        pos = idx * 2;
+        }
 
-        outSamples[i] = (Sint16)scaled;
+    SDL_PutAudioStreamData( inStream, scratch, (int)numBytes );
+    songReadPos = pos;
+    }
 
-        readSampleIndex++;
-        if( readSampleIndex == numSongSamples ) {
-            // loop back to the start of the song
-            readSampleIndex = 0;
-            }
+
+
+// DOS-PORT: convert the loaded song, once, into the device's negotiated
+// format, so the stream's input and the device's output are the same
+// spec and SDL's per-chunk ConvertAudio() takes its memcpy path. Integer
+// math only: the float path SDL_ConvertAudioSamples() would use takes
+// tens of seconds for a 3M-sample song on a 486. Handles the pairs this
+// port meets in practice -- S16 mono/stereo to U8 mono/stereo (the
+// PicoGUS / Sound Blaster 2.0 8-bit path), S16 mono to S16 stereo and
+// S16 stereo to S16 mono (a real SB16 or SB Pro) -- and leaves the song
+// untouched for anything else (a different rate, a float device), in
+// which case SDL converts per chunk exactly as before this patch.
+// Returns true when songBuffer now holds the device format.
+static char convertSongToDeviceFormat( const SDL_AudioSpec *inSong,
+                                       const SDL_AudioSpec *inDevice ) {
+    if( inSong->freq != inDevice->freq ) {
+        return false;
+        }
+    if( inSong->format != SDL_AUDIO_S16 ) {
+        return false;
+        }
+    if( inSong->channels < 1 || inSong->channels > 2 ||
+        inDevice->channels < 1 || inDevice->channels > 2 ) {
+        return false;
+        }
+    if( inDevice->format != SDL_AUDIO_U8 &&
+        inDevice->format != SDL_AUDIO_S16 ) {
+        return false;
+        }
+    if( inDevice->format == SDL_AUDIO_S16 &&
+        inDevice->channels == inSong->channels ) {
+        // already identical
+        return true;
         }
 
-    songReadPos = readSampleIndex * 2;
+    const Sint16 *src = (const Sint16 *)songBuffer;
+    const Uint32 numFrames = songBufferLen / ( 2 * inSong->channels );
+    const int outBytesPerSample = ( inDevice->format == SDL_AUDIO_U8 ) ? 1 : 2;
+    const Uint32 outLen = numFrames * outBytesPerSample * inDevice->channels;
 
-    SDL_PutAudioStreamData( inStream, outputBuffer, numBytes );
+    Uint8 *out = (Uint8 *)SDL_malloc( outLen );
+    if( out == NULL ) {
+        return false;
+        }
 
-    delete [] outputBuffer;
+    Uint8 *out8 = out;
+    Sint16 *out16 = (Sint16 *)out;
+
+    for( Uint32 f=0; f<numFrames; f++ ) {
+        int left, right;
+        if( inSong->channels == 2 ) {
+            left = src[ 2 * f ];
+            right = src[ 2 * f + 1 ];
+            }
+        else {
+            left = src[ f ];
+            right = left;
+            }
+
+        if( inDevice->channels == 1 ) {
+            // downmix: plain average, no headroom loss for a 16-bit sum
+            const int mono = ( left + right ) >> 1;
+            if( outBytesPerSample == 1 ) {
+                out8[ f ] = (Uint8)( ( mono >> 8 ) + 128 );
+                }
+            else {
+                out16[ f ] = (Sint16)mono;
+                }
+            }
+        else {
+            if( outBytesPerSample == 1 ) {
+                out8[ 2 * f ] = (Uint8)( ( left >> 8 ) + 128 );
+                out8[ 2 * f + 1 ] = (Uint8)( ( right >> 8 ) + 128 );
+                }
+            else {
+                out16[ 2 * f ] = (Sint16)left;
+                out16[ 2 * f + 1 ] = (Sint16)right;
+                }
+            }
+        }
+
+    SDL_free( songBuffer );
+    songBuffer = out;
+    songBufferLen = outLen;
+    songReadPos = 0;
+    return true;
     }
 
 
