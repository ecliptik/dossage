From 0430a0aba7019d45e609fc660515e9c557023061 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 26 Aug 2026 22:39:44 -0700
Subject: [PATCH] dos: replace live music synthesis with pre-rendered playback

Passage's music was a genuine real-time software synthesizer: every
audio callback recomputed envelope*wavetable per sample for every
currently-playing note (up to 4 simultaneous). That's real CPU work
competing with the game's video/logic loop on this DOS backend's
single-threaded, IRQ-driven scheduler, and there's a documented
real-hardware hazard (doskutsu's own campaign) where this class of
backend's audio starves below ~20-25 fps -- Passage's own 15fps target
sits below that floor.

The song (one loop through music.tga's note grid) is a fixed, mostly-
deterministic 136-second sequence -- entireGridDuraton = 0.25 *
w(544) -- decoded once at startup regardless. Since Passage never
needs to synthesize anything the player hasn't already heard before
(no procedural variation, no player-driven composition), the actual
per-sample synthesis math can be done once, offline, instead of live
on every playthrough.

tools/render-music/render_music.cpp (new, host-only, not part of the
DOS build) drives the *unchanged* synthesis logic -- renamed here from
audioCallback to synthesizeAudioCallback, but otherwise byte-for-byte
identical -- through one full loop, capturing the result to
gameSource/music/SONG.WAV (22050Hz stereo S16, matching the existing
sampleRate global exactly, ~11.4MB). A fixed rand() seed makes the
render reproducible (the noise timbre is the only non-deterministic
part of the synth); re-running the tool after this commit reproduces
the exact SONG.WAV committed here (verified: sha256 matches before and
after the musicPlayer.cpp rename, confirming the rename didn't change
behavior).

musicPlayer.cpp's live playback path (the new audioCallback) now just
memcpy-with-wraparound-and-gain from SONG.WAV instead of doing any
per-note math -- setMusicLoudness/restartMusic/startMusic/stopMusic's
external contracts to game.cpp are unchanged, so no other file needs
touching. loadMusicImage/noteGrid/Timbre/Envelope construction still
runs at startMusic() and is left fully intact (same one-time cost as
before, zero regression) -- unused for playback now, but staying
load-bearing for a future GUS/OPL/MIDI hardware-voice backend that
needs the same note-grid + envelope-shape data, per the audio-rewrite
plan. synthesizeAudioCallback (the original per-sample mixer) stays
in the tree too, as what the render tool calls and as that future
backend's scheduling reference.

Verified: host-native render tool builds and runs (CMake host SDL3
static lib), produces a valid, non-silent WAV (95% nonzero samples,
healthy amplitude, no clipping) matching entireGridDuraton exactly;
DOS cross-build compiles and links against the vendored DJGPP SDL3
static lib with no changes needed (SDL_LoadWAV's generic SDL_wave.c
was already included); smoke-tested under DOSBox-X -- SONG.WAV loads
without error, audio device opens successfully, 500+ frame flushes
with no crash.
---
 gameSource/musicPlayer.cpp | 105 ++++++++++++++++++++++++++++++++++---
 1 file changed, 97 insertions(+), 8 deletions(-)

diff --git a/gameSource/musicPlayer.cpp b/gameSource/musicPlayer.cpp
index 4b6f13c..0ecf001 100644
--- a/gameSource/musicPlayer.cpp
+++ b/gameSource/musicPlayer.cpp
@@ -108,6 +108,20 @@ SimpleVector<Note*> currentlyPlayingNotes;
 SDL_AudioStream *audioStream = NULL;
 
 
+// DOS-PORT: pre-rendered playback. The note-grid/Timbre/Envelope decode
+// above (loadMusicImage, still called from startMusic) stays intact for a
+// future hardware-voice backend (GUS/OPL/MIDI) to consume -- see the
+// audio-rewrite plan -- but the actual per-callback mix no longer walks
+// it sample-by-sample. Instead, tools/render-music/render_music.cpp
+// captures one full loop of that same synthesis offline, into
+// music/SONG.WAV, and audioCallback below just copies (with wraparound)
+// and scales by musicLoudness -- eliminating the per-frame synthesis
+// cost that competed with the game's video/logic loop on real hardware.
+Uint8 *songBuffer = NULL;
+Uint32 songBufferLen = 0;
+Uint32 songReadPos = 0;
+
+
 // need to synch these with audio thread
 
 void setMusicLoudness( double inLoudness ) {
@@ -123,11 +137,8 @@ void setMusicLoudness( double inLoudness ) {
 void restartMusic() {
     SDL_LockAudioStream( audioStream );
 
-    // return to beginning (and forget samples we've played so far)
-    streamSamples = 0;
-
-    // drop all currently-playing notes
-    currentlyPlayingNotes.deleteAll();
+    // return to beginning
+    songReadPos = 0;
 
     SDL_UnlockAudioStream( audioStream );
     }
@@ -135,11 +146,19 @@ void restartMusic() {
 
 
 
+// The original per-sample note-grid synthesis. No longer registered as
+// the live playback callback (see audioCallback below) -- kept, and
+// still fully working, as what tools/render-music/render_music.cpp calls
+// offline to (re-)produce music/SONG.WAV whenever the song, timbres, or
+// envelopes change. Also the reference implementation a future GUS/OPL/
+// MIDI backend's tick-scheduler translates note-grid + Envelope timing
+// from (see the audio-rewrite plan).
+//
 // DOS-PORT: SDL3's SDL_OpenAudioDeviceStream callback is a "pull" model --
 // SDL tells us how many additional bytes it wants (inAdditionalAmount) and
 // we push exactly that much (or more) via SDL_PutAudioStreamData, rather
 // than writing directly into a buffer SDL handed us (SDL1.2's model).
-void audioCallback( void *inUserData, SDL_AudioStream *inStream,
+void synthesizeAudioCallback( void *inUserData, SDL_AudioStream *inStream,
                     int inAdditionalAmount, int inTotalAmount ) {
 
     // 2 bytes for each channel of stereo sample; round up to a whole
@@ -322,6 +341,59 @@ void audioCallback( void *inUserData, SDL_AudioStream *inStream,
 
 
 
+// DOS-PORT: the live playback callback. Copies (with wraparound at the
+// end of the pre-rendered song) from songBuffer, scaling each S16 sample
+// by musicLoudness -- the only per-callback cost is one multiply per
+// sample, versus synthesizeAudioCallback's per-note envelope*wavetable
+// math above. This is what startMusic() registers with
+// SDL_OpenAudioDeviceStream.
+void audioCallback( void *inUserData, SDL_AudioStream *inStream,
+                    int inAdditionalAmount, int inTotalAmount ) {
+
+    if( songBuffer == NULL || songBufferLen == 0 ) {
+        return;
+        }
+
+    // round up to a whole number of stereo S16 frames (4 bytes/frame),
+    // same convention synthesizeAudioCallback above uses
+    int numBytes = ( ( inAdditionalAmount + 3 ) / 4 ) * 4;
+
+    Uint8 *outputBuffer = new Uint8[ numBytes ];
+
+    const Sint16 *songSamples = (const Sint16 *)songBuffer;
+    Sint16 *outSamples = (Sint16 *)outputBuffer;
+    int numSongSamples = songBufferLen / 2;
+    int readSampleIndex = songReadPos / 2;
+    int numOutSamples = numBytes / 2;
+
+    for( int i=0; i<numOutSamples; i++ ) {
+        double scaled = songSamples[ readSampleIndex ] * musicLoudness;
+
+        if( scaled > 32767 ) {
+            scaled = 32767;
+            }
+        else if( scaled < -32768 ) {
+            scaled = -32768;
+            }
+
+        outSamples[i] = (Sint16)scaled;
+
+        readSampleIndex++;
+        if( readSampleIndex == numSongSamples ) {
+            // loop back to the start of the song
+            readSampleIndex = 0;
+            }
+        }
+
+    songReadPos = readSampleIndex * 2;
+
+    SDL_PutAudioStreamData( inStream, outputBuffer, numBytes );
+
+    delete [] outputBuffer;
+    }
+
+
+
 // limit on n, based on Nyquist, when summing sine components
 //int nLimit = (int)( sampleRate * M_PI );
 // actually, this is way too many:  it takes forever to compute
@@ -597,9 +669,19 @@ void loadMusicImage( const char *inTGAFileName ) {
 
 
 void startMusic( const char *inTGAFileName ) {
-    
+
     loadMusicImage( inTGAFileName );
-    
+
+    // DOS-PORT: load the pre-rendered song (see audioCallback's comment
+    // above and tools/render-music/render_music.cpp) -- a single
+    // SDL_LoadWAV instead of live per-sample synthesis at playback time.
+    SDL_AudioSpec songSpec;
+    if( !SDL_LoadWAV( "music/SONG.WAV", &songSpec, &songBuffer,
+                       &songBufferLen ) ) {
+        printf( "Unable to load music/SONG.WAV: %s\n", SDL_GetError() );
+        return;
+        }
+
     SDL_AudioSpec audioFormat;
 
     /* Set 16-bit stereo audio at 22Khz */
@@ -630,6 +712,13 @@ void stopMusic() {
     SDL_DestroyAudioStream( audioStream );
     audioStream = NULL;
 
+    if( songBuffer != NULL ) {
+        SDL_free( songBuffer );
+        songBuffer = NULL;
+        songBufferLen = 0;
+        songReadPos = 0;
+        }
+
     if( musicImage != NULL ) {
         delete musicImage;
         musicImage = NULL;
-- 
