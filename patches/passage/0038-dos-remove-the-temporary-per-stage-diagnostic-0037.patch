-
-// DOS-PORT: TEMPORARY DIAGNOSTIC (STAGEDBG.LOG) -- per-stage frame cost,
-// aggregated per 300-frame window. REMOVAL IS PLANNED, NOT OPTIONAL: this
-// exists to re-run docs/BENCHMARK-PLAN.md's Section 1 compute-bound gate
-// on the 486DX2-50, where the first datum (13.685fps, 73.1ms/frame) says
-// the port is no longer pacer-bound, and to split the world-render loop
-// into cache-hit / cache-miss / transient sample counts so the render
-// lever can be picked from data. Same discipline as patches 0031/0032:
-// no per-frame file I/O (one fopen per 300 frames), a handful of
-// SDL_GetTicksNS() reads per frame (~10, each a PIT read), and every
-// span on the single SDL clock family.
-//
-// Spans, per frame:
-//   render  = loop top -> after drawScore()   (world sampling + score)
-//   blowup  = blowupOntoScreenNative()        (set inside flipGameImage..)
-//   present = presentScreen()                  (VRAM flush)
-//   pump    = every SDL_DOSAudioPump() call in the engine pump loop
-//   work    = loop top -> pacer entry          (everything before sleeping)
-//   pacer   = pacer entry -> post-pacer read   (sleep, or one yield if behind)
-//   tail    = post-pacer read -> loop end      (game logic, events)
-//   slack   = pacer's remainingNS at entry     (negative = over budget)
-struct DosPortDiagWindow {
-    int frames;
-    Uint64 renderNS, renderMaxNS;
-    Uint64 blowupNS, blowupMaxNS;
-    Uint64 presentNS, presentMaxNS;
-    Uint64 pumpNS, pumpMaxNS;
-    int pumpCalls;
-    Uint64 workNS, workMaxNS;
-    Uint64 pacerNS, pacerMaxNS;
-    Uint64 tailNS, tailMaxNS;
-    Sint64 slackSumNS, slackMinNS;
-    int overBudget, resyncs;
-    int hits, misses, transient;
-    };
-
-static struct DosPortDiagWindow dosPortDiag;
-static int dosPortDiagWindowIndex = 0;
-static Uint64 dosPortDiagBlowupNS = 0;
-static Uint64 dosPortDiagPresentNS = 0;
-
-// World.cpp's sample-cache counters (see sampleFromWorldNoWeightHash).
-extern int dosPortDiagSampleHits;
-extern int dosPortDiagSampleMisses;
-extern int dosPortDiagSampleTransient;
-
-#define DOS_PORT_DIAG_WINDOW_FRAMES 300
-
-static void dosPortDiagReset() {
-    memset( &dosPortDiag, 0, sizeof( dosPortDiag ) );
-    dosPortDiag.slackMinNS = (Sint64)0x7FFFFFFFFFFFFFFFLL;
-    dosPortDiagSampleHits = 0;
-    dosPortDiagSampleMisses = 0;
-    dosPortDiagSampleTransient = 0;
-    }
-
-static void dosPortDiagAccum( Uint64 *inSum, Uint64 *inMax, Uint64 inNS ) {
-    *inSum += inNS;
-    if( inNS > *inMax ) {
-        *inMax = inNS;
-        }
-    }
-
-static bool dosPortDiagPump() {
-    const Uint64 t0 = SDL_GetTicksNS();
-    const bool result = SDL_DOSAudioPump();
-    const Uint64 dt = SDL_GetTicksNS() - t0;
-    dosPortDiagAccum( &dosPortDiag.pumpNS, &dosPortDiag.pumpMaxNS, dt );
-    dosPortDiag.pumpCalls ++;
-    return result;
-    }
-
-static void dosPortDiagEmit( const char *inTag ) {
-    const int n = dosPortDiag.frames;
-    if( n <= 0 ) {
-        return;
-        }
-    FILE *f = fopen( "STAGEDBG.LOG", "a" );
-    if( f == NULL ) {
-        return;
-        }
-    const double ms = 1.0 / 1000000.0;
-    fprintf( f,
-             "[stage-window w=%d %s frames=%d] "
-             "render_avg=%.2f render_max=%.2f "
-             "blowup_avg=%.2f blowup_max=%.2f "
-             "present_avg=%.2f present_max=%.2f "
-             "pump_avg=%.2f pump_max=%.2f pump_calls=%d "
-             "work_avg=%.2f work_max=%.2f "
-             "pacer_avg=%.2f pacer_max=%.2f "
-             "tail_avg=%.2f tail_max=%.2f "
-             "slack_avg=%.2f slack_min=%.2f over_budget=%d resyncs=%d "
-             "hits=%d misses=%d transient=%d\n",
-             dosPortDiagWindowIndex, inTag, n,
-             dosPortDiag.renderNS * ms / n, dosPortDiag.renderMaxNS * ms,
-             dosPortDiag.blowupNS * ms / n, dosPortDiag.blowupMaxNS * ms,
-             dosPortDiag.presentNS * ms / n, dosPortDiag.presentMaxNS * ms,
-             dosPortDiag.pumpNS * ms / n, dosPortDiag.pumpMaxNS * ms,
-             dosPortDiag.pumpCalls,
-             dosPortDiag.workNS * ms / n, dosPortDiag.workMaxNS * ms,
-             dosPortDiag.pacerNS * ms / n, dosPortDiag.pacerMaxNS * ms,
-             dosPortDiag.tailNS * ms / n, dosPortDiag.tailMaxNS * ms,
-             (double)dosPortDiag.slackSumNS * ms / n,
-             (double)dosPortDiag.slackMinNS * ms,
-             dosPortDiag.overBudget, dosPortDiag.resyncs,
-             dosPortDiag.hits, dosPortDiag.misses, dosPortDiag.transient );
-    fclose( f );
-    dosPortDiagWindowIndex ++;
-    }
 #endif
 
 
