 gameSource/game.cpp | 143 ++++++++++++++++++++++++++------------------
 1 file changed, 86 insertions(+), 57 deletions(-)

diff --git a/gameSource/game.cpp b/gameSource/game.cpp
index 0f7dcd9..ed59d03 100644
--- a/gameSource/game.cpp
+++ b/gameSource/game.cpp
@@ -63,34 +63,40 @@ int main( int inArgCount, char **inArgs ) {
 // somehow exceeds this.
 #define DOS_PORT_FRAME_TIME_SAMPLE_CAP 20000
 
-// DOS-PORT: floor below which a captured sample -- the full paced period
-// between successive frames (see playGame()'s exit-block capture site;
-// this used to be the per-frame work time `frameTime`, before patch 0035
-// moved the capture site to also include each frame's own pacer sleep) --
-// cannot be a real measurement, derived from the clock's own documented
-// granularity
-// (Time::getCurrentTime() truncates to whole milliseconds -- TimeDOS.cpp's
-// tv_usec/1000, see the pacer's own comment on this above), not from any
-// assumption about how fast this game's per-frame work can get. A real
-// build-qa DOSBox-X run found roughly half of all captured samples in a
-// long life reading as low as ~7.6e-8s (a nonsensical ~13 million fps) --
-// confirmed by direct calculation that pure floating-point rounding of
-// two millisecond-quantized instants cannot produce a nonzero result
-// smaller than a genuine millisecond-scale difference on its own, so a
-// value this far below one clock tick means the underlying clock read
-// something non-monotonic or stale, not that a frame actually ran in
-// under a microsecond. Leading hypothesis (not yet confirmed by a
-// dedicated probe): DJGPP's gettimeofday() derives from the same
-// periodically-serviced BIOS tick counter this file's own pacer history
-// already documents as capable of stalling under insufficient yielding
-// (see the reverted busy-wait experiment's comment above, which measured
-// time(NULL) itself losing 54% of ticks on real hardware) -- a stalled
-// tick would read back near-identical to the previous call, then "catch
-// up" on the next real tick, which would produce exactly this near-zero/
-// compensating-large alternation. Filtering rather than trusting these
-// blindly. 0.001s (1ms) matches that floor without needing to assume
-// anything about this game's own performance profile.
+// DOS-PORT: bounds outside which a captured sample -- the full paced
+// period between successive frames, measured on SDL's own timebase
+// (SDL_GetTicksNS(), i.e. DJGPP uclock(), ~0.84us resolution; see the
+// capture site at the bottom of playGame()'s loop) -- cannot be a real
+// measurement.
+//
+// Patches 0034/0035 measured this quantity with Time::getCurrentTime()
+// (minorGems -> DJGPP gettimeofday()). That clock is unfit for the
+// purpose. The DJGPP libc reference for gettimeofday() says: "the values
+// are precise to less than 1/20 of a second only. The underlying DOS
+// function has 1/20 second granularity, as it is calculated from the
+// 55 ms timer tick count." A true ~66.67ms frame therefore always spans
+// one or two 54.9ms ticks and, reported in hundredths, reads back as
+// 50/60ms or 100/110ms -- which is exactly the fps_p50=16.67 /
+// fps_p95=9.09 pair every real-hardware run reported, bit-for-bit
+// identically, across three video cards and three CPUs
+// (docs/PACER-TIMING-INVESTIGATION.md), and what tests/probes/pacesim.c
+// reproduced in isolation with no SDL, rendering or audio present. The
+// percentiles were measuring the ruler, not the game. The near-zero
+// samples 0034's original filter was written against were the same
+// clock returning the same tick twice.
+//
+// SDL_GetTicksNS() is the clock the pacer itself converges against, so
+// pacing and measurement now share one clock family (the doskutsu
+// precedent, see docs/timing.md). Its one known hazard is that uclock()
+// is not monotonic on real DOS hardware (~1 corrupt sample per 1800
+// frames, SDL/0136's YIELDDBG data): a backwards step reads as a huge
+// delta if treated as unsigned. Both bounds guard that. The lower one
+// (still 1ms: no real paced period can be shorter than that, let alone
+// a frame's worth of work) catches the zero/negative side; the upper
+// one catches the wraparound side. Anything outside is counted and
+// reported in the exit block, never silently dropped.
 #define DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S 0.001
+#define DOS_PORT_FRAME_TIME_MAX_PLAUSIBLE_S 5.0
 
 static int dosPortCompareFrameTimes( const void *inA, const void *inB ) {
     double a = *(const double *)inA;
@@ -1156,6 +1162,14 @@ char playGame() {
     // count is visible data rather than a hidden correction.
     int frameTimeRejectedNonPositive = 0;
     int frameTimeRejectedTooSmall = 0;
+    int frameTimeRejectedTooLarge = 0;
+
+    // DOS-PORT: the previous frame's post-pacer SDL_GetTicksNS() reading,
+    // for the paced-period capture at the bottom of the loop. 0 means "no
+    // previous frame yet": the first iteration has no period to report
+    // and captures nothing (a delta back to before the title-screen wait
+    // would not be a frame period anyway).
+    Uint64 dosLastPacedTicksNS = 0;
 #endif
 
     int titleFadeFrame = 0;
@@ -1856,36 +1870,49 @@ char playGame() {
 
 #ifdef __DJGPP__
         // DOS-PORT: capture the full paced period -- the delta between
-        // this and the PREVIOUS "start timing next frame" timestamp, both
-        // taken AFTER their own pacer sleep -- for the RUNMANIFEST
-        // percentile buffer. Patch 0034 captured `frameTime` (pure work
-        // time, above) here instead; that quantity excludes every frame's
-        // own sleep by construction, so it is structurally >= 15fps
-        // whenever the pacer has any slack to spend (this rig always
-        // does in steady state) and cannot expose a pacer stall, which is
-        // the whole point of a stall-catching p95. The paced period sits
-        // at ~1/lockedFrameRate (~66.67ms) in steady state -- the pacer
-        // pads work time up to that budget every frame -- and only grows
-        // past it on a genuine stall, which is the actual "5% of frames
-        // were slower" shape p95 needs. Same reject-filter as before,
-        // applied to this quantity now instead of `frameTime` -- see
-        // DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S's own comment.
-        double pacedPeriodTimestamp = Time::getCurrentTime();
-        double pacedPeriod = pacedPeriodTimestamp - lastFrameTimeStamp;
-
-        if( pacedPeriod <= 0.0 ) {
-            frameTimeRejectedNonPositive ++;
-            }
-        else if( pacedPeriod < DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S ) {
-            frameTimeRejectedTooSmall ++;
-            }
-        else if( frameTimeSampleCount < DOS_PORT_FRAME_TIME_SAMPLE_CAP ) {
-            frameTimeSamples[ frameTimeSampleCount ] = pacedPeriod;
-            frameTimeSampleCount ++;
+        // this and the PREVIOUS post-pacer reading, both taken AFTER
+        // their own pacer sleep -- for the RUNMANIFEST percentile buffer.
+        // In steady state this sits at ~1/lockedFrameRate (~66.67ms),
+        // because the pacer pads work time up to that budget every frame,
+        // and only grows past it on a genuine stall: the "5% of frames
+        // were slower" shape a stall-catching p95 needs.
+        //
+        // Read on SDL's timebase, not Time::getCurrentTime(). Patch 0035
+        // borrowed the latter's single read for both this capture and the
+        // pacer's lastFrameTimeStamp; that clock has 55ms granularity and
+        // turned every run's percentiles into the same two constants --
+        // see DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S's comment for the full
+        // story. Signed delta, same as every other uclock()-derived
+        // difference in this file: a non-monotonic reading must land in
+        // a reject bucket, never in the buffer as a 2^64-scale "period".
+        const Uint64 pacedNowNS = SDL_GetTicksNS();
+
+        if( dosLastPacedTicksNS != 0 ) {
+            const Sint64 pacedPeriodNS =
+                (Sint64)pacedNowNS - (Sint64)dosLastPacedTicksNS;
+            const double pacedPeriod =
+                (double)pacedPeriodNS / (double)SDL_NS_PER_SECOND;
+
+            if( pacedPeriod <= 0.0 ) {
+                frameTimeRejectedNonPositive ++;
+                }
+            else if( pacedPeriod < DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S ) {
+                frameTimeRejectedTooSmall ++;
+                }
+            else if( pacedPeriod > DOS_PORT_FRAME_TIME_MAX_PLAUSIBLE_S ) {
+                frameTimeRejectedTooLarge ++;
+                }
+            else if( frameTimeSampleCount < DOS_PORT_FRAME_TIME_SAMPLE_CAP ) {
+                frameTimeSamples[ frameTimeSampleCount ] = pacedPeriod;
+                frameTimeSampleCount ++;
+                }
             }
+        dosLastPacedTicksNS = pacedNowNS;
 
-        // start timing next frame
-        lastFrameTimeStamp = pacedPeriodTimestamp;
+        // start timing next frame -- the pacer's own frameTime keeps
+        // reading Time::getCurrentTime(), exactly as it did before patch
+        // 0035 shared this read with the percentile capture.
+        lastFrameTimeStamp = Time::getCurrentTime();
 #else
         // start timing next frame
         lastFrameTimeStamp = Time::getCurrentTime();
@@ -2245,10 +2272,12 @@ char playGame() {
     // a finding (see DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S's own comment),
     // not something to correct quietly out of the percentile inputs.
     printf( "Frame-time samples: %d used, %d rejected non-positive, "
-            "%d rejected below %.3fs\n",
+            "%d rejected below %.3fs, %d rejected above %.1fs\n",
             frameTimeSampleCount, frameTimeRejectedNonPositive,
             frameTimeRejectedTooSmall,
-            (double)DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S );
+            (double)DOS_PORT_FRAME_TIME_MIN_PLAUSIBLE_S,
+            frameTimeRejectedTooLarge,
+            (double)DOS_PORT_FRAME_TIME_MAX_PLAUSIBLE_S );
 #endif
 
     fflush( stdout );
