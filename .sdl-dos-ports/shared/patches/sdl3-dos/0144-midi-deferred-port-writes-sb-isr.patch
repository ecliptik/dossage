diff --git a/include/SDL3/SDL_dosmidi_tick.h b/include/SDL3/SDL_dosmidi_tick.h
index 5fc98b637..e83486ebe 100644
--- a/include/SDL3/SDL_dosmidi_tick.h
+++ b/include/SDL3/SDL_dosmidi_tick.h
@@ -254,6 +254,34 @@ extern SDL_DECLSPEC bool SDLCALL SDL_DOSMidiIsrAnyActive(void);
  */
 extern SDL_DECLSPEC SDL_DOSMidiTickCallback SDLCALL SDL_DOSMidiTickGetRegistered(void);
 
+/**
+ * DOS-PORT patch 0144: deferred MIDI port writes, replayed by the SB IRQ.
+ *
+ * For a port whose MIDI scheduler runs on the main loop and cannot run in
+ * an ISR. While enabled for a kind (1 = OPL3 register writes, 2 = MPU-401
+ * bytes on the blind direct-port transport), every write of that kind is
+ * captured into a locked queue stamped with the current stamp
+ * (SDL_DOSMidiDeferSetStamp: an IRQ index, compare SDL_DOSMidiDeferIrqNow)
+ * and written out by the SB ISR at that IRQ. The port plans its song ahead
+ * of time, one IRQ slot at a time, setting the stamp for each slot. Returns
+ * false (nothing enabled) when the SB device is not open or, for kind 2,
+ * the MPU transport is not the blind direct one. Enable(0) stops
+ * capturing, writes out up to 1024 still-queued entries from the calling
+ * thread (interrupts off only around each batch of 32) and discards the
+ * rest, counted in SDL_DOSMidiDeferStats2. Default off.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSMidiDeferEnable(int kind);
+extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiDeferSetStamp(Uint32 irq_index);
+extern SDL_DECLSPEC Uint32 SDLCALL SDL_DOSMidiDeferIrqNow(void);
+extern SDL_DECLSPEC int SDLCALL SDL_DOSMidiDeferIrqPeriodUs(void);
+extern SDL_DECLSPEC int SDLCALL SDL_DOSMidiDeferFree(void);
+extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiDeferFlush(void);
+extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiDeferStats(Uint32 *written, Uint32 *late, Uint32 *late_max,
+                                                       Uint32 *burst_max, Uint32 *full);
+/* Entries discarded unplayed (a disable past its bound, or the device
+   closing with deferral on) and entries a disable wrote from the main thread. */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiDeferStats2(Uint32 *dropped, Uint32 *sync);
+
 /* Ends C function definitions when using C++ */
 #ifdef __cplusplus
 }
diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index bcfced73f..e53b31239 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -1639,6 +1639,244 @@ bool SDL_DOSMidiIsrTickActive(void)
     return g_dos_midi_isr_tick_active;
 }
 
+/* ========================================================================
+ * DOS-PORT patch 0144: deferred MIDI port writes, replayed by this ISR.
+ * ========================================================================
+ * A port whose MIDI scheduler runs on the main loop gets its note timing
+ * quantised to the render rate (every event due between two polls goes out
+ * in one batch at the next poll) and frozen through any main-loop stall.
+ * This keeps the scheduler and its sinks on the main thread, unchanged, but
+ * lets them run AHEAD: while enabled, every OPL register write
+ * (SDL_DOSOpl3WriteRegister) or MPU-401 byte (SDL_DOSMpu401WriteByte) of the
+ * enabled kind is captured into the queue below, stamped with the IRQ index
+ * it is due at (SDL_DOSMidiDeferSetStamp), and this ISR writes each entry out
+ * at that IRQ with raw port I/O only -- no FPU, no allocation, no SDL call;
+ * code and data locked when enabled. Default off: a port that never calls
+ * SDL_DOSMidiDeferEnable() sees one cached-bool test per IRQ and nothing else.
+ */
+#define MIDI_DEFER_QUEUE 8192u             /* entries, power of two */
+#define MIDI_DEFER_MAX_PER_IRQ 256u        /* bound on ISR time per IRQ */
+#define MIDI_DEFER_SYNC_MAX 1024u          /* bound on a disable's main-thread write-out */
+#define MIDI_DEFER_SYNC_BATCH 32u          /* entries per interrupts-off batch */
+volatile Uint8 g_mdq_kind = 0;             /* 0 off, 1 OPL3, 2 MPU-401 blind direct */
+volatile Uint8 g_mdq_hold = 0;             /* 1 = ISR writes nothing, capture refuses */
+static volatile Uint32 g_mdq_head = 0;     /* consumer (ISR) index, monotonic */
+static volatile Uint32 g_mdq_tail = 0;     /* producer (main thread) index, monotonic */
+static volatile Uint32 g_mdq_stamp_now = 0;/* stamp given to entries captured now */
+static Uint16 g_mdq_mpu_base = 0;
+static Uint32 g_mdq_stamp[MIDI_DEFER_QUEUE];
+static Uint16 g_mdq_reg[MIDI_DEFER_QUEUE];
+static Uint8 g_mdq_val[MIDI_DEFER_QUEUE];
+static volatile Uint32 g_mdq_written = 0;  /* entries written out by the ISR */
+static volatile Uint32 g_mdq_late = 0;     /* ... of which written >= 1 IRQ after their stamp */
+static volatile Uint32 g_mdq_late_max = 0; /* the most IRQs any entry was late */
+static volatile Uint32 g_mdq_burst_max = 0;/* the most entries written in one IRQ */
+static volatile Uint32 g_mdq_full = 0;     /* captures refused because the queue was full */
+static volatile Uint32 g_mdq_dropped = 0;  /* entries discarded unplayed (bounded disable, device close) */
+static volatile Uint32 g_mdq_sync = 0;     /* entries written from the main thread by a disable */
+static bool g_mdq_locked = false;
+
+static void MidiDeferWriteOne(Uint32 idx)
+{
+    const Uint16 reg = g_mdq_reg[idx];
+    const Uint8 val = g_mdq_val[idx];
+    if (g_mdq_kind == 2) {
+        outportb(g_mdq_mpu_base, val);
+        return;
+    }
+    /* OPL: the same address/data sequence as SDL_DOSOpl3WriteRegister. */
+    const Uint16 addr_port = (reg < 0x100) ? 0x388 : 0x38A;
+    const Uint16 data_port = (reg < 0x100) ? 0x389 : 0x38B;
+    outportb(addr_port, (Uint8)(reg & 0xFF));
+    for (int i = 0; i < 6; i++) {
+        (void)inportb(0x388);
+    }
+    outportb(data_port, val);
+    for (int i = 0; i < 6; i++) {
+        (void)inportb(0x388);
+    }
+}
+
+static void MidiDeferDrain(Uint32 irq_now)
+{
+    Uint32 n = 0;
+    if (g_mdq_hold) {
+        return; /* chip detect/init/shutdown in progress on the main thread */
+    }
+    while (g_mdq_head != g_mdq_tail && n < MIDI_DEFER_MAX_PER_IRQ) {
+        __asm__ __volatile__("" ::: "memory"); /* read the entry after seeing the tail */
+        const Uint32 idx = g_mdq_head & (MIDI_DEFER_QUEUE - 1u);
+        const Sint32 late = (Sint32)(irq_now - g_mdq_stamp[idx]);
+        if (late < 0) {
+            break; /* FIFO: the head is not due yet, nothing behind it is either */
+        }
+        MidiDeferWriteOne(idx);
+        g_mdq_head = g_mdq_head + 1u;
+        g_mdq_written++;
+        if (late >= 1) {
+            g_mdq_late++;
+            if ((Uint32)late > g_mdq_late_max) {
+                g_mdq_late_max = (Uint32)late;
+            }
+        }
+        n++;
+    }
+    if (n > g_mdq_burst_max) {
+        g_mdq_burst_max = n;
+    }
+}
+static void MidiDeferDrain_End(void) {}
+
+/* Main thread. Captures one write for later; false = not captured (the
+   caller writes it directly). Refused when off, for the other kind, or
+   when the queue is full (counted). */
+bool SDL_DOSMidiDeferCapture(Uint8 kind, Uint16 reg, Uint8 val)
+{
+    if (g_mdq_kind == 0 || g_mdq_kind != kind) {
+        return false;
+    }
+    if (g_mdq_tail - g_mdq_head >= MIDI_DEFER_QUEUE) {
+        g_mdq_full++;
+        return false;
+    }
+    const Uint32 idx = g_mdq_tail & (MIDI_DEFER_QUEUE - 1u);
+    g_mdq_stamp[idx] = g_mdq_stamp_now;
+    g_mdq_reg[idx] = reg;
+    g_mdq_val[idx] = val;
+    __asm__ __volatile__("" ::: "memory"); /* the entry is stored before the tail moves */
+    g_mdq_tail = g_mdq_tail + 1u; /* publish after the entry is complete */
+    return true;
+}
+
+bool SDL_DOSMidiDeferHold(bool hold)
+{
+    if (hold) {
+        if (g_mdq_kind == 0) {
+            return false;
+        }
+        g_mdq_hold = 1;
+        return true;
+    }
+    g_mdq_hold = 0;
+    return true;
+}
+
+Uint32 SDL_DOSMidiDeferIrqNow(void)
+{
+    return dos_port_audio_irq_count;
+}
+
+int SDL_DOSMidiDeferIrqPeriodUs(void)
+{
+    SDL_AudioDevice *device = g_dos_audio_device;
+    if (!device || device->spec.freq <= 0) {
+        return 0;
+    }
+    return (int)(((Sint64)device->sample_frames * 1000000) / device->spec.freq);
+}
+
+void SDL_DOSMidiDeferSetStamp(Uint32 irq_index)
+{
+    g_mdq_stamp_now = irq_index;
+}
+
+int SDL_DOSMidiDeferFree(void)
+{
+    return (int)(MIDI_DEFER_QUEUE - (g_mdq_tail - g_mdq_head));
+}
+
+void SDL_DOSMidiDeferFlush(void)
+{
+    DOS_DisableInterrupts();
+    g_mdq_head = g_mdq_tail;
+    DOS_EnableInterrupts();
+}
+
+void SDL_DOSMidiDeferStats2(Uint32 *dropped, Uint32 *sync)
+{
+    if (dropped) *dropped = g_mdq_dropped;
+    if (sync) *sync = g_mdq_sync;
+}
+
+void SDL_DOSMidiDeferStats(Uint32 *written, Uint32 *late, Uint32 *late_max, Uint32 *burst_max, Uint32 *full)
+{
+    if (written) *written = g_mdq_written;
+    if (late) *late = g_mdq_late;
+    if (late_max) *late_max = g_mdq_late_max;
+    if (burst_max) *burst_max = g_mdq_burst_max;
+    if (full) *full = g_mdq_full;
+}
+
+bool SDL_DOSMidiDeferEnable(int kind)
+{
+    if (kind == 0) {
+        /* Off: stop the ISR consuming, then write out what is still queued
+           from here -- at most MIDI_DEFER_SYNC_MAX entries, in batches of
+           MIDI_DEFER_SYNC_BATCH with interrupts off only around each batch
+           (a long cli on ISA loses timer ticks, and uclock is the pacer's
+           clock); anything beyond the bound is discarded and counted. The
+           ports' own stop path flushes the planned-ahead writes first, so
+           normally only a song's note-offs are left here. */
+        if (g_mdq_kind == 0) {
+            return true;
+        }
+        const Uint8 k = g_mdq_kind;
+        DOS_DisableInterrupts();
+        g_mdq_kind = 0; /* the ISR stops draining; capture refuses */
+        DOS_EnableInterrupts();
+        Uint32 done = 0;
+        while (g_mdq_head != g_mdq_tail && done < MIDI_DEFER_SYNC_MAX) {
+            DOS_DisableInterrupts();
+            for (Uint32 b = 0; b < MIDI_DEFER_SYNC_BATCH && g_mdq_head != g_mdq_tail; b++) {
+                const Uint32 idx = g_mdq_head & (MIDI_DEFER_QUEUE - 1u);
+                if (k == 2) {
+                    outportb(g_mdq_mpu_base, g_mdq_val[idx]);
+                } else {
+                    const Uint16 reg = g_mdq_reg[idx];
+                    outportb((reg < 0x100) ? 0x388 : 0x38A, (Uint8)(reg & 0xFF));
+                    for (int i = 0; i < 6; i++) (void)inportb(0x388);
+                    outportb((reg < 0x100) ? 0x389 : 0x38B, g_mdq_val[idx]);
+                    for (int i = 0; i < 6; i++) (void)inportb(0x388);
+                }
+                g_mdq_head = g_mdq_head + 1u;
+                done++;
+            }
+            DOS_EnableInterrupts();
+        }
+        g_mdq_sync += done;
+        g_mdq_dropped += g_mdq_tail - g_mdq_head;
+        g_mdq_head = g_mdq_tail;
+        return true;
+    }
+    if (!g_dos_sb_device_open || (kind != 1 && kind != 2)) {
+        return false; /* no SB IRQ to replay from */
+    }
+    if (kind == 2 && !SDL_DOSMpu401BlindDirectBase(&g_mdq_mpu_base)) {
+        return false; /* DSP-mediated, DRR-poll or TX-delay transport: not ISR-safe here */
+    }
+    if (!g_mdq_locked) {
+        DOS_LockCode(MidiDeferWriteOne, MidiDeferDrain_End);
+        DOS_LockData(g_mdq_stamp, sizeof(g_mdq_stamp));
+        DOS_LockData(g_mdq_reg, sizeof(g_mdq_reg));
+        DOS_LockData(g_mdq_val, sizeof(g_mdq_val));
+        DOS_LockVariable(g_mdq_kind);
+        DOS_LockVariable(g_mdq_head);
+        DOS_LockVariable(g_mdq_tail);
+        DOS_LockVariable(g_mdq_mpu_base);
+        DOS_LockVariable(g_mdq_written);
+        DOS_LockVariable(g_mdq_late);
+        DOS_LockVariable(g_mdq_late_max);
+        DOS_LockVariable(g_mdq_burst_max);
+        g_mdq_locked = true;
+    }
+    DOS_DisableInterrupts();
+    g_mdq_head = g_mdq_tail;
+    g_mdq_stamp_now = dos_port_audio_irq_count;
+    g_mdq_kind = (Uint8)kind;
+    DOS_EnableInterrupts();
+    return true;
+}
+
 // The IRQ handler. Copies one chunk from the ring buffer into the DMA
 // half-buffer that the hardware isn't currently playing. If the ring is
 // empty it fills with silence (no stutter, just a brief gap).
@@ -1745,6 +1983,11 @@ static void SoundBlasterIRQHandler(void)
         dos_port_audio_sfx_active_count++;
     }
 
+    /* DOS-PORT patch 0144: replay the deferred MIDI writes due by now. */
+    if (g_mdq_kind != 0) {
+        MidiDeferDrain(dos_port_audio_irq_count);
+    }
+
     /* DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- MidiScheduler
        tick from the IRQ-5 ISR. Cached-bool gated + callback-non-NULL
        gated; under killswitch OFF or no engine callback registered
@@ -2918,6 +3161,8 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
     DOS_LockCode(ISR_GetDMAHalf, ISR_GetDMAHalf_End);
     DOS_LockData(*hidden->ring_buffer, hidden->ring_size);
     DOS_LockVariable(isr_ring_read);
+    DOS_LockVariable(g_mdq_kind); /* DOS-PORT patch 0144: tested by the ISR every IRQ, and by the */
+    DOS_LockVariable(g_mdq_hold); /* OPL/MPU write primitives, which a port's own ISR may call */
     DOS_LockVariable(isr_ring_write);
     DOS_LockVariable(isr_ring_size);
     DOS_LockVariable(isr_ring_mask);
@@ -4159,6 +4404,16 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
 static void DOSSOUNDBLASTER_CloseDevice(SDL_AudioDevice *device)
 {
     struct SDL_PrivateAudioData *hidden = device->hidden;
+    /* DOS-PORT patch 0144: the IRQ that replays deferred MIDI writes is going
+       away. Stop deferring (later writes go direct) and discard what is still
+       queued, counted -- there is no clock left to play it on. */
+    if (g_mdq_kind != 0) {
