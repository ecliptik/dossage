     /* gus-9: the gus-8 on_song_start data-present PEEK (6x gus_peek on the GF1
        DRAM port) is REMOVED -- it wedged the PicoGUS (any diag-added GF1 read
        does, even main-context with voices stopped). The datum it gave already
@@ -1245,6 +1254,36 @@ Uint32 SDL_DOSGusUploadSample(const void *data, Uint32 len, int is16bit)
     return dram_addr;
 }
 
+/* patch 0139: overwrite an already-allocated DRAM region in place. See
+   SDL_dosgus.h's own doc comment for the full rationale (UploadSample's
+   bump allocator has no reuse primitive; a caller that refills the same
+   fixed address repeatedly -- e.g. a double-buffered PCM stream -- would
+   otherwise permanently consume new DRAM on every refill until the card's
+   <=1MB budget is exhausted, typically within a couple of minutes). Reuses
+   gus_upload_to() verbatim: this function changes only the destination
+   address, nothing about the transfer mechanics gusdmawedge.c's own
+   real-hardware pass already exercised (that pass targeted a freshly
+   bump-allocated address; this path targets a caller-supplied one -- the
+   confirming extension to that probe, not yet run on real hardware as of
+   this patch landing, is what actually validates the "inherits the
+   existing wedge finding by construction" claim below). */
+bool SDL_DOSGusOverwriteSample(Uint32 dram_addr, const void *data, Uint32 len, int is16bit)
+{
+    if (!g_gus_active || !data || len == 0) {
+        return false;
+    }
+    /* Overflow-safe bounds check: dram_addr + len must not wrap Uint32
+       before comparing against dram_size. */
+    if (len > g_gus_dram_size || dram_addr > g_gus_dram_size - len) {
+        return false;
+    }
+    if (g_gus_diag) {
+        gus_diag_flush();
+    }
+    gus_upload_to(dram_addr, data, len, is16bit);
+    return true;
+}
+
 void SDL_DOSGusResetDram(Uint32 keep_bytes)
 {
     if (!g_gus_active) {
