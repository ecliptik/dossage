diff --git a/include/SDL3/SDL_dosaudio_pump.h b/include/SDL3/SDL_dosaudio_pump.h
index 0275aec64..91dea200d 100644
--- a/include/SDL3/SDL_dosaudio_pump.h
+++ b/include/SDL3/SDL_dosaudio_pump.h
@@ -434,6 +434,26 @@ extern SDL_DECLSPEC int SDLCALL SDL_DOSAudioPhysicalCapacityFrames(void);
  */
 extern SDL_DECLSPEC int SDLCALL SDL_DOSAudioIsrRingWrite(void);
 
+/**
+ * DOS-PORT patch 0143: tell the SB driver whether sound content is playing.
+ *
+ * The driver's post-mix silence gate drops any buffer that is silent in the
+ * device format instead of writing it to the ring. Between sounds that is the
+ * point (the ring drains, the device idles). DURING a sound it removes time:
+ * a clip's own digital-zero pause, or on the 8-bit path any passage quieter
+ * than one U8 step, is dropped and the next audible chunk plays early -- the
+ * sound comes out shorter, with its pauses shortened.
+ *
+ * While `active` is true, silent buffers are written like any other. Set it
+ * true while the port's own mixer still has audio to deliver, false when
+ * everything it started has been fully handed to SDL. A port that never calls
+ * this gets the gate exactly as before (the default is false).
+ *
+ * \param active true while content is playing.
+ * \threadsafety Call from the thread that feeds the audio stream.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSAudioSetContentActive(bool active);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 9309470ee..bcfced73f 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -987,6 +987,17 @@ static void dos_sfx_synth_recompute_ratediv(void)
     }
 }
 
+/* DOS-PORT patch 0143: content-active flag for PlayDevice's silence gate.
+   Written by the engine's main thread, read by PlayDevice under
+   device->lock (audio thread or SDL_DOSAudioPump); a single aligned bool, so
+   a racing read sees either value, and either is safe. */
+static volatile bool g_dos_audio_content_active = false;
+
+void SDL_DOSAudioSetContentActive(bool active)
+{
+    g_dos_audio_content_active = active;
+}
