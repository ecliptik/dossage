# <NAME> -- the target-software profile for the vcctrl harness.
#
# Modeled on doskutsu's own profiles/doskutsu.yaml (in doskutsu's own
# repo, not vcctrl's -- every port tracks its profile in its own repo
# now; see sdl-dos-ports' docs/hardware-testing.md, "The orchestration
# layer" section). Everything in this file is a fact about YOUR DOS
# program and the machine it runs on -- nothing here is a fact about
# vcctrl itself, and nothing here belongs in the rig's vcctrl.yaml (that
# file stays machine-local and is not tracked in any repo).
#
# harness/vcctrl-sweep|-cell|-collect are profile-driven as of
# 2026-09-11 (dosags's slice 6) -- they read this file, not a hardcoded
# doskutsu path. Every optional section below is genuinely optional:
# leaving one out (null, or omitted) makes the corresponding vcctrl-cell
# guard skip cleanly with a printed reason, rather than faulting or
# faking another port's values. Fill in only what your port actually
# has; a section that describes something your port doesn't do yet is
# worse than an absent one. See sdl-dos-ports' docs/hardware-testing.md
# before using this for the full design and doskutsu's own
# profiles/doskutsu.yaml for a real, fully-populated example.

version: 1
name: <name>

# ------------------------------------------------------------------ target
target:
  # Where the program lives and is run from, on the DOS target.
  dir: "C:\\<NAME>"
  configs: "CFGS"
  ftp_put: "C:\\MTCP\\PUT.BAT"

  # The executable a single cell launches (vcctrl's harness/vcctrl-cell).
  # NOTE: vcctrl-cell assumes an executable that takes NO command-line
  # arguments and is configured entirely via environment variables and/or
  # a config file (doskutsu's own shape). If your program instead needs
  # real CLI args and/or shell stdout redirection to run (dosags's own
  # AGS.EXE does), vcctrl-cell is the wrong tool for your real-hardware
  # runs regardless of what you fill in here -- use vcctrl's generic
  # stage-file/send-file/get-file primitives with your own RUN.BAT
  # instead (see docs/hardware-testing.md's "Manual workflow" section,
  # and dosags's tests/harness/run-rig.sh for a real example). Still fill
  # this in for documentation purposes even if you end up not using
  # vcctrl-cell -- `exe` is a fact about your port either way.
  exe: "<NAME>.EXE"

  # Per-card config switching (vcctrl-cell's --cfg). `default_cfg` is
  # what a cell uses when --cfg is not passed; `cfg_dest` is the filename
  # the engine itself reads. Leave BOTH null if your port has no
  # config-file-switching mechanism -- inventing one here would make
  # vcctrl-cell copy a file that means nothing on your target.
  default_cfg: null
  cfg_dest: null

  # The command that resets the environment before a cell sets its own
  # variables (vcctrl-cell). Null/absent skips this step entirely -- a
  # port with no such command (nothing to call, nothing to gain by
  # pretending to) should leave this null rather than invent one.
  env_clear_cmd: null

  # Default TAS replay tape + PRNG seed a cell arms unless --set
  # overrides them (vcctrl-cell). Only used when `env.replay`/`env.seed`
  # below are ALSO set -- a port with no TAS-replay mechanism (a
  # script-driven autopilot baked into the package itself, say) declares
  # neither pair.
  default_replay: null
  default_seed: null

  # The unattended-sweep harness's own entry point (vcctrl-sweep), typed
  # as `<sweep_entry_cmd> <machine> <declared-hw...>`. Null/absent for a
  # port with no sweep harness at all -- vcctrl-sweep already refuses
  # cleanly for a profile with no `sweeps:`/`machines:` section below;
  # this is just the command name for if/when one exists.
  sweep_entry_cmd: null

  # Per-video-card env overrides (vcctrl-cell), found empirically. Keyed
  # by --card value; each entry maps a semantic key from `env:` below to
  # the value that card needs. Leave this an empty map until you've
  # actually found and confirmed a real per-card requirement -- an
  # invented override is worse than none.
  card_overrides: {}

  # THE BOOT-PROFILE WITNESS. Whatever env var or file your CONFIG.SYS/
  # AUTOEXEC.BAT boot-menu profiles set differently is what proves which
  # profile is currently loaded -- a cell must verify this before trusting
  # its results. Keep this ONE-DIRECTIONAL: presence should prove one
  # specific positive fact (e.g. "a sound profile is loaded, so this is
  # NOT the network profile"), never be read backwards as proof of absence
  # of some other profile. See vcctrl's docs/HARNESS-STANDARD.md sec. 12
  # and docs/lab/OPEN-FAULTS.md sec. 15 for why this matters -- a naive
  # "prove NET by an absent BLASTER" check will happily accept a profile
  # with no network stack at all and fail silently later. Leave
  # `variable`/`value`/`proves` all null if your port has no boot-menu
  # profile-switching system at all yet -- there is nothing for a
  # witness to distinguish, and vcctrl-cell skips the whole check
  # cleanly when `variable` is null.
  profile_witness:
    variable: null
    value: null
    proves: null
    direction: one-way

  # The env var names YOUR program itself consults -- do not invent names
  # here that nothing on the target reads. Fill in only what your port
  # actually implements (TAS replay / deterministic seed / auto-exit /
  # log tagging / native-mode pin / screenshot ticks are doskutsu's set;
  # yours may differ or be a subset -- leave the rest null).
  env:
    replay: null
    seed: null
    auto_exit_tick: null
    log_tag: null
    pin_native_mode: null
    shot_ticks: null
    # Harness-side, not engine-side: a flag your OWN QA batch files (not
    # vcctrl, not your program's engine) consult to keep the console in
    # a capture-friendly mode between cells. Null if you have no such
    # mechanism -- most new ports won't yet.
    capture_flag: null

timing:
  # How long your boot menu waits before timing out and picking a default,
  # in seconds -- this is target physics, not rig physics. The keystroke
  # budget for hitting a menu choice in time is derived from this plus the
  # rig's own keyboard-buffer depth (declared in vcctrl.yaml), not here.
  menu_window_s: 14

# ----------------------------------------------------------------- machines
# Tag and display name per CPU your project targets. Match sdl-dos-ports'
# HARDWARE.md matrix where possible so results stay comparable across ports.
machines:
  "1": {tag: "P", name: "Pentium OverDrive 83"}
  "2": {tag: "A", name: "Am5x86-133"}
  "3": {tag: "6", name: "486DX2-66"}
  "4": {tag: "5", name: "486DX2-50"}

# ------------------------------------------------------------------- sweeps
# Optional. Only meaningful once you have a scripted/TAS-driven unattended
# multi-cell run to describe -- vcctrl-sweep refuses cleanly against a
# profile with no sweeps/machines section, so omitting this entirely
# (rather than a single-package script-driven harness like dosags's own
# tests/harness/, which doesn't need this at all) is a normal, valid
# state, not a gap to fill in preemptively. Per-sweep wall-clock budgets
# should be measured, not guessed -- state which machine/run the timeout
# was derived from.
#
# sweeps:
#   <SWEEP_NAME>:
#     cells: <count>
#     timeout_min: <budget, ~2x the slowest machine's measured time>
#     measured: "<Xm Ys> on <machine>"
#     tags: ["<cell-tag>", ...]
